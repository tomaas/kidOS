{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/usr/bin/zsh -lc \"nl -ba src/app/parents/reglages.tsx | sed -n '1,760p'; nl -ba src/config/app.ts | sed -n '1,180p'; nl -ba src/components/printable-story.tsx | sed -n '1,180p'; nl -ba src/app/__root.tsx | sed -n '1,180p'; nl -ba Dockerfile | sed -n '1,180p'\"","aggregated_output":"     1\timport { createFileRoute, Link, useRouter } from \"@tanstack/react-router\";\n     2\timport { Home } from \"lucide-react\";\n     3\timport type { ReactNode } from \"react\";\n     4\timport { useState } from \"react\";\n     5\timport { Button } from \"~/components/ui/button\";\n     6\timport { Input } from \"~/components/ui/input\";\n     7\timport { composeBranding } from \"~/config/app\";\n     8\timport { formatMessage, useLocale, useMessages } from \"~/lib/i18n\";\n     9\timport type {\n    10\t  AppSettingsStatus,\n    11\t  SecretStatus,\n    12\t  SettingKey,\n    13\t} from \"~/server/app-config\";\n    14\timport {\n    15\t  getAppSettingsStatusFn,\n    16\t  saveAppSettingsFn,\n    17\t} from \"~/server/settings-functions\";\n    18\t\n    19\texport const Route = createFileRoute(\"/parents/reglages\")({\n    20\t  component: ParentsReglagesPage,\n    21\t  loader: () => getAppSettingsStatusFn(),\n    22\t});\n    23\t\n    24\t/** Une opération du patch — le miroir client du SettingPatchOp serveur\n    25\t * (types importés en type-only : aucun code serveur dans le bundle). */\n    26\ttype Operation =\n    27\t  | { key: SettingKey; op: \"set\"; value: string }\n    28\t  | { key: SettingKey; op: \"delete\" };\n    29\t\n    30\ttype EtatEnregistrement =\n    31\t  | \"repos\"\n    32\t  | \"enregistrement\"\n    33\t  | \"enregistre\"\n    34\t  | \"impossible\";\n    35\t\n    36\t/**\n    37\t * Page parent (URL-only, jamais liée depuis le flux enfant) : les réglages\n    38\t * de l'atelier — clés, modèles, images, voix — posés en base (app_settings),\n    39\t * avec l'env du déploiement en secours. Chaque section enregistre un PATCH\n    40\t * de ses seuls champs modifiés (une transaction serveur) : deux onglets sur\n    41\t * des sections différentes ne s'écrasent jamais.\n    42\t *\n    43\t * Contrainte calme : page parent, états neutres (« non configurée » n'est\n    44\t * jamais une urgence), aucun rouge, aucune validation harcelante. Les\n    45\t * SECRETS ne redescendent jamais : le serveur ne renvoie que\n    46\t * {configured, hint}. Quatre opérations par clé : conserver (champ vide au\n    47\t * moment d'enregistrer) / définir / Effacer (masque explicite) / Revenir au\n    48\t * réglage du déploiement.\n    49\t */\n    50\tfunction ParentsReglagesPage() {\n    51\t  const m = useMessages();\n    52\t  const status = Route.useLoaderData();\n    53\t\n    54\t  return (\n    55\t    <div className=\"mx-auto w-full max-w-3xl space-y-8\">\n    56\t      <div>\n    57\t        <Button\n    58\t          className=\"gap-2 text-lg text-muted-foreground\"\n    59\t          nativeButton={false}\n    60\t          render={<Link to=\"/\" />}\n    61\t          variant=\"ghost\"\n    62\t        >\n    63\t          <Home className=\"size-5\" />\n    64\t          {m.commun.accueil}\n    65\t        </Button>\n    66\t      </div>\n    67\t\n    68\t      <div className=\"space-y-2\">\n    69\t        <h1 className=\"font-bold text-3xl\">{m.parents.reglages.titre}</h1>\n    70\t        <p className=\"text-muted-foreground\">{m.parents.reglages.intro}</p>\n    71\t      </div>\n    72\t\n    73\t      <SectionAtelier status={status} />\n    74\t      <SectionHistoires status={status} />\n    75\t      <SectionImages status={status} />\n    76\t      <SectionVoix status={status} />\n    77\t    </div>\n    78\t  );\n    79\t}\n    80\t\n    81\t/** Enregistrement partagé : envoie le patch, invalide le loader (l'onglet\n    82\t * qui enregistre voit l'état frais ; un AUTRE onglet converge à son prochain\n    83\t * rechargement — la frontière de cohérence documentée). */\n    84\tfunction useEnregistrement() {\n    85\t  const router = useRouter();\n    86\t  const [etat, setEtat] = useState<EtatEnregistrement>(\"repos\");\n    87\t\n    88\t  async function enregistrer(operations: Operation[]): Promise<boolean> {\n    89\t    if (operations.length === 0) {\n    90\t      return true;\n    91\t    }\n    92\t    setEtat(\"enregistrement\");\n    93\t    const result = await saveAppSettingsFn({ data: { operations } });\n    94\t    if (result.success) {\n    95\t      setEtat(\"enregistre\");\n    96\t      await router.invalidate();\n    97\t      return true;\n    98\t    }\n    99\t    setEtat(\"impossible\");\n   100\t    return false;\n   101\t  }\n   102\t\n   103\t  return { enregistrer, etat };\n   104\t}\n   105\t\n   106\tfunction MessageEtat({ etat }: { etat: EtatEnregistrement }) {\n   107\t  const m = useMessages();\n   108\t  if (etat === \"enregistre\") {\n   109\t    return (\n   110\t      <p className=\"text-muted-foreground text-sm\">\n   111\t        {m.parents.reglages.enregistre}\n   112\t      </p>\n   113\t    );\n   114\t  }\n   115\t  if (etat === \"impossible\") {\n   116\t    return (\n   117\t      <p className=\"text-muted-foreground text-sm\">\n   118\t        {m.parents.enregistrementImpossible}\n   119\t      </p>\n   120\t    );\n   121\t  }\n   122\t  return null;\n   123\t}\n   124\t\n   125\tfunction BadgeDefaut() {\n   126\t  const m = useMessages();\n   127\t  return (\n   128\t    <span className=\"rounded-full bg-muted px-2 py-0.5 text-muted-foreground text-xs\">\n   129\t      {m.parents.reglages.badgeDefaut}\n   130\t    </span>\n   131\t  );\n   132\t}\n   133\t\n   134\tfunction LigneChamp({\n   135\t  badge,\n   136\t  children,\n   137\t  label,\n   138\t}: {\n   139\t  badge: boolean;\n   140\t  children: ReactNode;\n   141\t  label: string;\n   142\t}) {\n   143\t  return (\n   144\t    <div className=\"space-y-1.5\">\n   145\t      <div className=\"flex flex-wrap items-center gap-2\">\n   146\t        <span className=\"font-medium text-sm\">{label}</span>\n   147\t        {badge ? <BadgeDefaut /> : null}\n   148\t      </div>\n   149\t      {children}\n   150\t    </div>\n   151\t  );\n   152\t}\n   153\t\n   154\t/**\n   155\t * Un champ SECRET : jamais la valeur — seulement « une clé est en place\n   156\t * (…xyz) » ou « aucune clé ». L'input sert uniquement à POSER une nouvelle\n   157\t * clé (vide = conserver) ; Effacer = masque explicite (la clé du\n   158\t * déploiement ne s'applique plus) ; Revenir = supprimer la ligne (la valeur\n   159\t * du déploiement reprend), proposé seulement quand une ligne existe.\n   160\t */\n   161\tfunction ChampSecret({\n   162\t  label,\n   163\t  onChange,\n   164\t  onEffacer,\n   165\t  onRevenir,\n   166\t  secret,\n   167\t  value,\n   168\t}: {\n   169\t  label: string;\n   170\t  onChange: (value: string) => void;\n   171\t  onEffacer: () => void;\n   172\t  onRevenir: () => void;\n   173\t  secret: SecretStatus;\n   174\t  value: string;\n   175\t}) {\n   176\t  const m = useMessages();\n   177\t  let etatCle = m.parents.reglages.cleNonConfiguree;\n   178\t  if (secret.configured) {\n   179\t    etatCle = secret.hint\n   180\t      ? formatMessage(m.parents.reglages.cleEnPlace, { indice: secret.hint })\n   181\t      : m.parents.reglages.cleEnPlaceSansIndice;\n   182\t  }\n   183\t\n   184\t  return (\n   185\t    <LigneChamp badge={secret.source === \"default\"} label={label}>\n   186\t      <p className=\"text-muted-foreground text-sm\">{etatCle}</p>\n   187\t      <Input\n   188\t        autoComplete=\"off\"\n   189\t        onChange={(event) => onChange(event.target.value)}\n   190\t        placeholder={m.parents.reglages.garderCle}\n   191\t        type=\"password\"\n   192\t        value={value}\n   193\t      />\n   194\t      <div className=\"flex flex-wrap gap-2\">\n   195\t        {secret.configured ? (\n   196\t          <Button\n   197\t            aria-label={formatMessage(m.parents.reglages.ariaEffacer, {\n   198\t              champ: label,\n   199\t            })}\n   200\t            onClick={onEffacer}\n   201\t            size=\"sm\"\n   202\t            variant=\"outline\"\n   203\t          >\n   204\t            {m.parents.reglages.effacer}\n   205\t          </Button>\n   206\t        ) : null}\n   207\t        {secret.source === \"db\" ? (\n   208\t          <Button\n   209\t            aria-label={formatMessage(m.parents.reglages.ariaRevenirDefaut, {\n   210\t              champ: label,\n   211\t            })}\n   212\t            onClick={onRevenir}\n   213\t            size=\"sm\"\n   214\t            variant=\"outline\"\n   215\t          >\n   216\t            {m.parents.reglages.revenirDefaut}\n   217\t          </Button>\n   218\t        ) : null}\n   219\t      </div>\n   220\t    </LigneChamp>\n   221\t  );\n   222\t}\n   223\t\n   224\t/** Le choix binaire calme (Activées/Désactivées…) — deux boutons, comme le\n   225\t * choix de langue de l'espace parent. */\n   226\tfunction ChoixBinaire({\n   227\t  label,\n   228\t  labelActive,\n   229\t  labelInactive,\n   230\t  onChange,\n   231\t  source,\n   232\t  value,\n   233\t}: {\n   234\t  label: string;\n   235\t  labelActive: string;\n   236\t  labelInactive: string;\n   237\t  onChange: (value: boolean) => void;\n   238\t  source: \"db\" | \"default\";\n   239\t  value: boolean;\n   240\t}) {\n   241\t  return (\n   242\t    <LigneChamp badge={source === \"default\"} label={label}>\n   243\t      <div className=\"flex gap-2\">\n   244\t        <Button\n   245\t          onClick={() => onChange(true)}\n   246\t          size=\"sm\"\n   247\t          variant={value ? \"default\" : \"outline\"}\n   248\t        >\n   249\t          {labelActive}\n   250\t        </Button>\n   251\t        <Button\n   252\t          onClick={() => onChange(false)}\n   253\t          size=\"sm\"\n   254\t          variant={value ? \"outline\" : \"default\"}\n   255\t        >\n   256\t          {labelInactive}\n   257\t        </Button>\n   258\t      </div>\n   259\t    </LigneChamp>\n   260\t  );\n   261\t}\n   262\t\n   263\t/** Un choix parmi quelques valeurs fermées (résolution, fournisseur). */\n   264\tfunction ChoixEnum<T extends string>({\n   265\t  label,\n   266\t  onChange,\n   267\t  options,\n   268\t  source,\n   269\t  value,\n   270\t}: {\n   271\t  label: string;\n   272\t  onChange: (value: T) => void;\n   273\t  options: readonly { id: T; label: string }[];\n   274\t  source: \"db\" | \"default\";\n   275\t  value: T;\n   276\t}) {\n   277\t  return (\n   278\t    <LigneChamp badge={source === \"default\"} label={label}>\n   279\t      <div className=\"flex flex-wrap gap-2\">\n   280\t        {options.map((option) => (\n   281\t          <Button\n   282\t            key={option.id}\n   283\t            onClick={() => onChange(option.id)}\n   284\t            size=\"sm\"\n   285\t            variant={option.id === value ? \"default\" : \"outline\"}\n   286\t          >\n   287\t            {option.label}\n   288\t          </Button>\n   289\t        ))}\n   290\t      </div>\n   291\t    </LigneChamp>\n   292\t  );\n   293\t}\n   294\t\n   295\tfunction CarteSection({\n   296\t  children,\n   297\t  description,\n   298\t  emoji,\n   299\t  titre,\n   300\t}: {\n   301\t  children: ReactNode;\n   302\t  description: string;\n   303\t  emoji: string;\n   304\t  titre: string;\n   305\t}) {\n   306\t  return (\n   307\t    <section className=\"space-y-5 rounded-2xl border bg-card p-5\">\n   308\t      <div className=\"flex items-start gap-4\">\n   309\t        <span aria-hidden=\"true\" className=\"text-4xl leading-none\">\n   310\t          {emoji}\n   311\t        </span>\n   312\t        <div className=\"min-w-0 flex-1\">\n   313\t          <h2 className=\"font-semibold text-xl\">{titre}</h2>\n   314\t          <p className=\"text-muted-foreground text-sm\">{description}</p>\n   315\t        </div>\n   316\t      </div>\n   317\t      {children}\n   318\t    </section>\n   319\t  );\n   320\t}\n   321\t\n   322\t/* ── Sections ────────────────────────────────────────────────────────────── */\n   323\t\n   324\t/**\n   325\t * Le prénom & les textes de l'atelier — la marque, posée en base (plus\n   326\t * jamais un rebuild Docker pour renommer l'enfant). L'aperçu se dérive en\n   327\t * direct via la pure composeBranding ; un champ vidé reprend la valeur du\n   328\t * déploiement (VITE_*).\n   329\t */\n   330\tfunction SectionAtelier({ status }: { status: AppSettingsStatus }) {\n   331\t  const m = useMessages();\n   332\t  const t = m.parents.reglages.sections.atelier;\n   333\t  const locale = useLocale();\n   334\t  const { enregistrer, etat } = useEnregistrement();\n   335\t  const [prenom, setPrenom] = useState(status.branding.childName.value);\n   336\t  const [nomApp, setNomApp] = useState(status.branding.appName.value);\n   337\t  const [descriptionApp, setDescriptionApp] = useState(\n   338\t    status.branding.appDescription.value\n   339\t  );\n   340\t  const [titreLivret, setTitreLivret] = useState(\n   341\t    status.branding.storyLabel.value\n   342\t  );\n   343\t\n   344\t  // Aperçu en direct (pure composeBranding — la même dérivation que le\n   345\t  // serveur) : le nom d'atelier et la signature du livret qui suivraient.\n   346\t  const apercu = composeBranding(locale, {\n   347\t    appDescription: descriptionApp,\n   348\t    appName: nomApp,\n   349\t    childName: prenom,\n   350\t    storyLabel: titreLivret,\n   351\t  });\n   352\t\n   353\t  function onEnregistrer() {\n   354\t    const operations: Operation[] = [];\n   355\t    const champs: [SettingKey, string, string][] = [\n   356\t      [\"branding:child-name\", prenom, status.branding.childName.value],\n   357\t      [\"branding:app-name\", nomApp, status.branding.appName.value],\n   358\t      [\n   359\t        \"branding:app-description\",\n   360\t        descriptionApp,\n   361\t        status.branding.appDescription.value,\n   362\t      ],\n   363\t      [\"branding:story-label\", titreLivret, status.branding.storyLabel.value],\n   364\t    ];\n   365\t    for (const [key, valeur, initiale] of champs) {\n   366\t      if (valeur !== initiale) {\n   367\t        operations.push({ key, op: \"set\", value: valeur.trim() });\n   368\t      }\n   369\t    }\n   370\t    enregistrer(operations);\n   371\t  }\n   372\t\n   373\t  return (\n   374\t    <CarteSection description={t.description} emoji=\"🏡\" titre={t.titre}>\n   375\t      <LigneChamp\n   376\t        badge={status.branding.childName.source === \"default\"}\n   377\t        label={t.prenom}\n   378\t      >\n   379\t        <Input\n   380\t          onChange={(event) => setPrenom(event.target.value)}\n   381\t          value={prenom}\n   382\t        />\n   383\t      </LigneChamp>\n   384\t      <LigneChamp\n   385\t        badge={status.branding.appName.source === \"default\"}\n   386\t        label={t.nomApp}\n   387\t      >\n   388\t        <Input\n   389\t          onChange={(event) => setNomApp(event.target.value)}\n   390\t          value={nomApp}\n   391\t        />\n   392\t      </LigneChamp>\n   393\t      <LigneChamp\n   394\t        badge={status.branding.appDescription.source === \"default\"}\n   395\t        label={t.descriptionApp}\n   396\t      >\n   397\t        <Input\n   398\t          onChange={(event) => setDescriptionApp(event.target.value)}\n   399\t          value={descriptionApp}\n   400\t        />\n   401\t      </LigneChamp>\n   402\t      <LigneChamp\n   403\t        badge={status.branding.storyLabel.source === \"default\"}\n   404\t        label={t.titreLivret}\n   405\t      >\n   406\t        <Input\n   407\t          onChange={(event) => setTitreLivret(event.target.value)}\n   408\t          value={titreLivret}\n   409\t        />\n   410\t      </LigneChamp>\n   411\t      <div className=\"rounded-xl bg-muted/50 p-4\">\n   412\t        <p className=\"font-medium text-muted-foreground text-xs\">{t.apercu}</p>\n   413\t        <p className=\"font-semibold\">{apercu.name}</p>\n   414\t        <p className=\"text-muted-foreground text-sm italic\">\n   415\t          {apercu.storyLabel}\n   416\t        </p>\n   417\t      </div>\n   418\t      <p className=\"text-muted-foreground text-xs\">\n   419\t        {m.parents.reglages.champVide}\n   420\t      </p>\n   421\t      <div className=\"flex items-center gap-3\">\n   422\t        <Button disabled={etat === \"enregistrement\"} onClick={onEnregistrer}>\n   423\t          {m.parents.reglages.enregistrer}\n   424\t        </Button>\n   425\t        <MessageEtat etat={etat} />\n   426\t      </div>\n   427\t    </CarteSection>\n   428\t  );\n   429\t}\n   430\t\n   431\tfunction SectionHistoires({ status }: { status: AppSettingsStatus }) {\n   432\t  const m = useMessages();\n   433\t  const t = m.parents.reglages.sections.histoires;\n   434\t  const { enregistrer, etat } = useEnregistrement();\n   435\t  const [nouvelleCle, setNouvelleCle] = useState(\"\");\n   436\t  const [modele, setModele] = useState(status.provider.storyModel.value);\n   437\t\n   438\t  async function onEnregistrer() {\n   439\t    const operations: Operation[] = [];\n   440\t    if (nouvelleCle.trim() !== \"\") {\n   441\t      operations.push({\n   442\t        key: \"text:anthropic-api-key\",\n   443\t        op: \"set\",\n   444\t        value: nouvelleCle.trim(),\n   445\t      });\n   446\t    }\n   447\t    if (modele !== status.provider.storyModel.value) {\n   448\t      operations.push({ key: \"text:story-model\", op: \"set\", value: modele });\n   449\t    }\n   450\t    if (await enregistrer(operations)) {\n   451\t      setNouvelleCle(\"\");\n   452\t    }\n   453\t  }\n   454\t\n   455\t  return (\n   456\t    <CarteSection description={t.description} emoji=\"📖\" titre={t.titre}>\n   457\t      <ChampSecret\n   458\t        label={t.cle}\n   459\t        onChange={setNouvelleCle}\n   460\t        onEffacer={() =>\n   461\t          enregistrer([{ key: \"text:anthropic-api-key\", op: \"set\", value: \"\" }])\n   462\t        }\n   463\t        onRevenir={() =>\n   464\t          enregistrer([{ key: \"text:anthropic-api-key\", op: \"delete\" }])\n   465\t        }\n   466\t        secret={status.provider.anthropicApiKey}\n   467\t        value={nouvelleCle}\n   468\t      />\n   469\t      <LigneChamp\n   470\t        badge={status.provider.storyModel.source === \"default\"}\n   471\t        label={t.modele}\n   472\t      >\n   473\t        <Input\n   474\t          onChange={(event) => setModele(event.target.value)}\n   475\t          value={modele}\n   476\t        />\n   477\t        <p className=\"text-muted-foreground text-xs\">\n   478\t          {m.parents.reglages.champVide}\n   479\t        </p>\n   480\t      </LigneChamp>\n   481\t      <div className=\"flex items-center gap-3\">\n   482\t        <Button disabled={etat === \"enregistrement\"} onClick={onEnregistrer}>\n   483\t          {m.parents.reglages.enregistrer}\n   484\t        </Button>\n   485\t        <MessageEtat etat={etat} />\n   486\t      </div>\n   487\t    </CarteSection>\n   488\t  );\n   489\t}\n   490\t\n   491\tfunction SectionImages({ status }: { status: AppSettingsStatus }) {\n   492\t  const m = useMessages();\n   493\t  const t = m.parents.reglages.sections.images;\n   494\t  const { enregistrer, etat } = useEnregistrement();\n   495\t  const [active, setActive] = useState(status.provider.imageEnabled.value);\n   496\t  const [nouvelleCle, setNouvelleCle] = useState(\"\");\n   497\t  const [modele, setModele] = useState(status.provider.imageModel.value);\n   498\t  const [resolution, setResolution] = useState(\n   499\t    status.provider.imageResolution.value\n   500\t  );\n   501\t\n   502\t  async function onEnregistrer() {\n   503\t    const operations: Operation[] = [];\n   504\t    if (active !== status.provider.imageEnabled.value) {\n   505\t      operations.push({\n   506\t        key: \"image:enabled\",\n   507\t        op: \"set\",\n   508\t        value: String(active),\n   509\t      });\n   510\t    }\n   511\t    if (nouvelleCle.trim() !== \"\") {\n   512\t      operations.push({\n   513\t        key: \"image:gemini-api-key\",\n   514\t        op: \"set\",\n   515\t        value: nouvelleCle.trim(),\n   516\t      });\n   517\t    }\n   518\t    if (modele !== status.provider.imageModel.value) {\n   519\t      operations.push({ key: \"image:model\", op: \"set\", value: modele });\n   520\t    }\n   521\t    if (resolution !== status.provider.imageResolution.value) {\n   522\t      operations.push({\n   523\t        key: \"image:resolution\",\n   524\t        op: \"set\",\n   525\t        value: resolution,\n   526\t      });\n   527\t    }\n   528\t    if (await enregistrer(operations)) {\n   529\t      setNouvelleCle(\"\");\n   530\t    }\n   531\t  }\n   532\t\n   533\t  return (\n   534\t    <CarteSection description={t.description} emoji=\"🎨\" titre={t.titre}>\n   535\t      <ChoixBinaire\n   536\t        label={t.etat}\n   537\t        labelActive={t.activees}\n   538\t        labelInactive={t.desactivees}\n   539\t        onChange={setActive}\n   540\t        source={status.provider.imageEnabled.source}\n   541\t        value={active}\n   542\t      />\n   543\t      <ChampSecret\n   544\t        label={t.cle}\n   545\t        onChange={setNouvelleCle}\n   546\t        onEffacer={() =>\n   547\t          enregistrer([{ key: \"image:gemini-api-key\", op: \"set\", value: \"\" }])\n   548\t        }\n   549\t        onRevenir={() =>\n   550\t          enregistrer([{ key: \"image:gemini-api-key\", op: \"delete\" }])\n   551\t        }\n   552\t        secret={status.provider.geminiApiKey}\n   553\t        value={nouvelleCle}\n   554\t      />\n   555\t      <LigneChamp\n   556\t        badge={status.provider.imageModel.source === \"default\"}\n   557\t        label={t.modele}\n   558\t      >\n   559\t        <Input\n   560\t          onChange={(event) => setModele(event.target.value)}\n   561\t          value={modele}\n   562\t        />\n   563\t        <p className=\"text-muted-foreground text-xs\">\n   564\t          {m.parents.reglages.champVide}\n   565\t        </p>\n   566\t      </LigneChamp>\n   567\t      <ChoixEnum\n   568\t        label={t.resolution}\n   569\t        onChange={setResolution}\n   570\t        options={[\n   571\t          { id: \"512\", label: \"512\" },\n   572\t          { id: \"1K\", label: \"1K\" },\n   573\t          { id: \"2K\", label: \"2K\" },\n   574\t          { id: \"4K\", label: \"4K\" },\n   575\t        ]}\n   576\t        source={status.provider.imageResolution.source}\n   577\t        value={resolution}\n   578\t      />\n   579\t      <div className=\"flex items-center gap-3\">\n   580\t        <Button disabled={etat === \"enregistrement\"} onClick={onEnregistrer}>\n   581\t          {m.parents.reglages.enregistrer}\n   582\t        </Button>\n   583\t        <MessageEtat etat={etat} />\n   584\t      </div>\n   585\t    </CarteSection>\n   586\t  );\n   587\t}\n   588\t\n   589\tfunction SectionVoix({ status }: { status: AppSettingsStatus }) {\n   590\t  const m = useMessages();\n   591\t  const t = m.parents.reglages.sections.voix;\n   592\t  const { enregistrer, etat } = useEnregistrement();\n   593\t  const [active, setActive] = useState(status.provider.ttsEnabled.value);\n   594\t  const [fournisseur, setFournisseur] = useState(\n   595\t    status.provider.ttsProvider.value\n   596\t  );\n   597\t  const [nouvelleCle, setNouvelleCle] = useState(\"\");\n   598\t\n   599\t  async function onEnregistrer() {\n   600\t    const operations: Operation[] = [];\n   601\t    if (active !== status.provider.ttsEnabled.value) {\n   602\t      operations.push({ key: \"tts:enabled\", op: \"set\", value: String(active) });\n   603\t    }\n   604\t    if (fournisseur !== status.provider.ttsProvider.value) {\n   605\t      operations.push({ key: \"tts:provider\", op: \"set\", value: fournisseur });\n   606\t    }\n   607\t    if (nouvelleCle.trim() !== \"\") {\n   608\t      operations.push({\n   609\t        key: \"tts:elevenlabs-api-key\",\n   610\t        op: \"set\",\n   611\t        value: nouvelleCle.trim(),\n   612\t      });\n   613\t    }\n   614\t    if (await enregistrer(operations)) {\n   615\t      setNouvelleCle(\"\");\n   616\t    }\n   617\t  }\n   618\t\n   619\t  return (\n   620\t    <CarteSection description={t.description} emoji=\"🔊\" titre={t.titre}>\n   621\t      <ChoixBinaire\n   622\t        label={t.etat}\n   623\t        labelActive={t.activee}\n   624\t        labelInactive={t.desactivee}\n   625\t        onChange={setActive}\n   626\t        source={status.provider.ttsEnabled.source}\n   627\t        value={active}\n   628\t      />\n   629\t      <ChoixEnum\n   630\t        label={t.fournisseur}\n   631\t        onChange={setFournisseur}\n   632\t        options={[\n   633\t          { id: \"edge\", label: \"Edge\" },\n   634\t          { id: \"elevenlabs\", label: \"ElevenLabs\" },\n   635\t        ]}\n   636\t        source={status.provider.ttsProvider.source}\n   637\t        value={fournisseur}\n   638\t      />\n   639\t      {fournisseur === \"elevenlabs\" ? (\n   640\t        <ChampSecret\n   641\t          label={t.cle}\n   642\t          onChange={setNouvelleCle}\n   643\t          onEffacer={() =>\n   644\t            enregistrer([\n   645\t              { key: \"tts:elevenlabs-api-key\", op: \"set\", value: \"\" },\n   646\t            ])\n   647\t          }\n   648\t          onRevenir={() =>\n   649\t            enregistrer([{ key: \"tts:elevenlabs-api-key\", op: \"delete\" }])\n   650\t          }\n   651\t          secret={status.provider.elevenLabsApiKey}\n   652\t          value={nouvelleCle}\n   653\t        />\n   654\t      ) : null}\n   655\t      <div className=\"flex items-center gap-3\">\n   656\t        <Button disabled={etat === \"enregistrement\"} onClick={onEnregistrer}>\n   657\t          {m.parents.reglages.enregistrer}\n   658\t        </Button>\n   659\t        <MessageEtat etat={etat} />\n   660\t      </div>\n   661\t    </CarteSection>\n   662\t  );\n   663\t}\n     1\t/**\n     2\t * App-wide branding — depuis le passage env→DB, la personnalisation vit dans\n     3\t * `app_settings` (branding:* — posée à /parents/reglages, section « Le\n     4\t * prénom & l'atelier ») avec les VITE_* du déploiement en SECOURS\n     5\t * (`envFallbackConfig` dans src/server/app-config.ts) : renommer l'enfant ne\n     6\t * demande plus de rebuild Docker.\n     7\t *\n     8\t * Ce module ne garde que la COMPOSITION PURE : les dérivations par langue\n     9\t * (élision française incluse) vivent dans `buildBranding`\n    10\t * (src/lib/i18n/branding.ts, golden-testée) ; `composeBranding` y applique\n    11\t * les overrides plein-texte (appName/appDescription/storyLabel) quand la\n    12\t * phrase dérivée ne convient pas. Les valeurs entrent par le loader racine\n    13\t * (shell : titre d'onglet, portrait) ou par l'instantané AppConfig côté\n    14\t * serveur (titre d'histoire de repli) — TOUJOURS avec la bonne langue :\n    15\t * la locale UI pour le shell, la langue FIGÉE de l'histoire (stories.lang)\n    16\t * pour le colophon imprimé et le titre de repli.\n    17\t */\n    18\t\n    19\timport { type Branding, buildBranding } from \"~/lib/i18n\";\n    20\t\n    21\t/** La source de marque BRUTE (\"\" = non défini) — miroir structurel de\n    22\t * `BrandingConfig` (server/app-config.ts), défini localement pour qu'un\n    23\t * module de config importable côté client ne touche jamais au serveur. */\n    24\texport interface BrandingSource {\n    25\t  appDescription: string;\n    26\t  appName: string;\n    27\t  childName: string;\n    28\t  storyLabel: string;\n    29\t}\n    30\t\n    31\t/** Les langues d'HISTOIRE (\"fr\" | \"ru\" | \"en\") — le russe n'a pas de marque\n    32\t * dédiée et retombe sur la dérivation française, comme historiquement. */\n    33\texport type BrandingLang = \"fr\" | \"ru\" | \"en\";\n    34\t\n    35\texport function composeBranding(\n    36\t  lang: BrandingLang,\n    37\t  source: BrandingSource\n    38\t): Branding {\n    39\t  const derived = buildBranding(\n    40\t    lang === \"en\" ? \"en\" : \"fr\",\n    41\t    source.childName.trim()\n    42\t  );\n    43\t  return {\n    44\t    description: source.appDescription || derived.description,\n    45\t    name: source.appName || derived.name,\n    46\t    storyLabel: source.storyLabel || derived.storyLabel,\n    47\t  };\n    48\t}\n     1\timport { getRouteApi } from \"@tanstack/react-router\";\n     2\timport { composeBranding } from \"~/config/app\";\n     3\timport {\n     4\t  GENERATED_IMAGE_HEIGHT,\n     5\t  GENERATED_IMAGE_WIDTH,\n     6\t} from \"~/lib/generated-image\";\n     7\timport type { ReadingAidsFlags } from \"~/lib/use-reading-aids\";\n     8\timport type { StorySegment } from \"~/server/db/schema\";\n     9\timport { isRenderableImagePath } from \"~/server/providers/types\";\n    10\timport { HighlightableText } from \"./highlightable-text\";\n    11\t\n    12\tconst rootRoute = getRouteApi(\"__root__\");\n    13\t\n    14\t/**\n    15\t * The discreet colophon printed at the end of every booklet.\n    16\t * Shared with the operations sheet (printable-operations.tsx).\n    17\t *\n    18\t * `lang` = la langue du CONTENU imprimé : la langue FIGÉE de l'histoire\n    19\t * (stories.lang — une histoire anglaise imprimée sous une UI française garde\n    20\t * sa marque anglaise, codex #5), la locale de l'atelier pour la fiche\n    21\t * d'opérations. La source de marque vient du loader racine (réglage parent\n    22\t * en base, VITE_* en secours).\n    23\t */\n    24\texport function Colophon({ lang }: { lang: string }) {\n    25\t  const { brandingSource } = rootRoute.useLoaderData();\n    26\t  // stories.lang est une colonne non typée — une valeur inconnue retombe sur\n    27\t  // la marque française historique, jamais une erreur.\n    28\t  const brandingLang = lang === \"en\" || lang === \"ru\" ? lang : \"fr\";\n    29\t  return (\n    30\t    <p\n    31\t      className=\"mt-16 text-center italic\"\n    32\t      style={{ fontSize: \"12pt\", opacity: 0.6 }}\n    33\t    >\n    34\t      {composeBranding(brandingLang, brandingSource).storyLabel}\n    35\t    </p>\n    36\t  );\n    37\t}\n    38\t\n    39\t/**\n    40\t * Print-only A5 booklet for a dynamic (\"choose-your-path\") story: the title,\n    41\t * then each beat of the chosen path in order — its illustration (if any) and\n    42\t * big text — flowing one after another, then the discreet colophon. Renders\n    43\t * whatever images exist; a missing image just leaves that beat text-only and\n    44\t * never blocks the booklet. Same @media print rules as the classic booklet.\n    45\t * The on-screen reading aids (lettres muettes, liaisons) print too, so the\n    46\t * booklet matches real reading-education books — softened by the print CSS.\n    47\t */\n    48\texport function PrintableDynamicStory({\n    49\t  title,\n    50\t  segments,\n    51\t  aids,\n    52\t  lang,\n    53\t}: {\n    54\t  title: string;\n    55\t  segments: StorySegment[];\n    56\t  aids: ReadingAidsFlags;\n    57\t  /** La langue FIGÉE de l'histoire — pilote la marque du colophon. */\n    58\t  lang: string;\n    59\t}) {\n    60\t  return (\n    61\t    <article className=\"printable-story hidden\">\n    62\t      <h1\n    63\t        className=\"mb-10 text-center font-bold\"\n    64\t        style={{ fontSize: \"28pt\", lineHeight: 1.3 }}\n    65\t      >\n    66\t        {title}\n    67\t      </h1>\n    68\t\n    69\t      <div className=\"space-y-10\">\n    70\t        {segments.map((segment) => (\n    71\t          <div className=\"space-y-6\" key={`print-seg-${segment.id}`}>\n    72\t            {isRenderableImagePath(segment.imagePath) ? (\n    73\t              <img\n    74\t                alt=\"\"\n    75\t                className=\"w-full rounded-lg\"\n    76\t                height={GENERATED_IMAGE_HEIGHT}\n    77\t                src={segment.imagePath}\n    78\t                style={{ maxHeight: \"80mm\", objectFit: \"cover\" }}\n    79\t                width={GENERATED_IMAGE_WIDTH}\n    80\t              />\n    81\t            ) : null}\n    82\t            <div\n    83\t              className=\"space-y-6\"\n    84\t              style={{ fontSize: \"18pt\", lineHeight: 1.8 }}\n    85\t            >\n    86\t              {segment.paragraphs.map((paragraph, i) => (\n    87\t                <p key={`${segment.id}-print-${i}`}>\n    88\t                  <HighlightableText\n    89\t                    showLiaisons={aids.showLiaisons}\n    90\t                    showSilent={aids.showSilent}\n    91\t                    text={paragraph}\n    92\t                  />\n    93\t                </p>\n    94\t              ))}\n    95\t            </div>\n    96\t          </div>\n    97\t        ))}\n    98\t      </div>\n    99\t\n   100\t      <Colophon lang={lang} />\n   101\t    </article>\n   102\t  );\n   103\t}\n     1\timport {\n     2\t  createRootRoute,\n     3\t  HeadContent,\n     4\t  Outlet,\n     5\t  Scripts,\n     6\t  useRouterState,\n     7\t} from \"@tanstack/react-router\";\n     8\timport type { ReactNode } from \"react\";\n     9\timport { Toaster } from \"~/components/ui/sonner\";\n    10\timport {\n    11\t  buildBranding,\n    12\t  type Locale,\n    13\t  LocaleProvider,\n    14\t  MESSAGES,\n    15\t  normalizeLocale,\n    16\t} from \"~/lib/i18n\";\n    17\timport { getShellContextFn } from \"~/server/settings-functions\";\n    18\timport appCss from \"./globals.css?url\";\n    19\t\n    20\t/**\n    21\t * Écrans d'erreur/404 AUTO-CONTENUS (eng-review D24-A) : le shell est\n    22\t * route-aware (plein-bleed pour la couche bureau) — ces écrans apportent donc\n    23\t * leur propre conteneur centré, pour rendre cohérents dans les deux modes\n    24\t * (jamais un plein-bleed cassé après un crash dans la fenêtre).\n    25\t */\n    26\tconst CALM_SCREEN_CLASS =\n    27\t  \"mx-auto flex min-h-[80vh] w-full max-w-5xl flex-col items-center justify-center gap-6 px-6 py-10 text-center\";\n    28\t\n    29\t/**\n    30\t * La locale UI depuis le loaderData du match racine, via l'état du router —\n    31\t * disponible PARTOUT où le router rend, y compris errorComponent /\n    32\t * notFoundComponent (qui rendent hors du LocaleProvider de RootComponent).\n    33\t * `normalizeLocale` absorbe un loaderData absent (erreur très tôt) → \"fr\",\n    34\t * jamais une exception dans un écran d'erreur.\n    35\t */\n    36\tfunction useRootLocale(): Locale {\n    37\t  return useRouterState({\n    38\t    select: (s) =>\n    39\t      normalizeLocale(\n    40\t        (s.matches[0]?.loaderData as { locale?: unknown } | undefined)?.locale\n    41\t      ),\n    42\t  });\n    43\t}\n    44\t\n    45\texport const Route = createRootRoute({\n    46\t  component: RootComponent,\n    47\t  errorComponent: () => <EcranCalme variante=\"souci\" />,\n    48\t  head: ({ loaderData }) => {\n    49\t    // Le titre d'onglet et la meta description suivent la locale UI (réglage\n    50\t    // parent) et la marque posée en base (branding:* — env VITE_* en\n    51\t    // secours), composées par le SERVEUR dans le loader. Repli générique si\n    52\t    // le loader n'a rien fourni (erreur très tôt) — jamais une exception.\n    53\t    const branding =\n    54\t      loaderData?.branding ??\n    55\t      buildBranding(normalizeLocale(loaderData?.locale), \"\");\n    56\t    return {\n    57\t      links: [\n    58\t        { href: \"https://fonts.googleapis.com\", rel: \"preconnect\" },\n    59\t        {\n    60\t          crossOrigin: \"anonymous\",\n    61\t          href: \"https://fonts.gstatic.com\",\n    62\t          rel: \"preconnect\",\n    63\t        },\n    64\t        { href: appCss, rel: \"stylesheet\" },\n    65\t        {\n    66\t          href: \"https://fonts.googleapis.com/css2?family=Quicksand:wght@400..700&display=swap\",\n    67\t          rel: \"stylesheet\",\n    68\t        },\n    69\t      ],\n    70\t      meta: [\n    71\t        { charSet: \"utf-8\" },\n    72\t        {\n    73\t          content: \"width=device-width, initial-scale=1\",\n    74\t          name: \"viewport\",\n    75\t        },\n    76\t        { title: branding.name },\n    77\t        {\n    78\t          content: branding.description,\n    79\t          name: \"description\",\n    80\t        },\n    81\t      ],\n    82\t    };\n    83\t  },\n    84\t  // La locale UI ET la marque (réglages parent, table app_settings) entrent\n    85\t  // dans l'app par CE loader et nulle part ailleurs. getShellContextFn ne\n    86\t  // jette jamais (replis internes) — le shell rend toujours.\n    87\t  // staleTime: Infinity : ces réglages ne changent que par /parents, qui\n    88\t  // fait router.invalidate() ; un AUTRE onglet converge à son prochain\n    89\t  // rechargement — le rechargement est la frontière de cohérence documentée.\n    90\t  loader: () => getShellContextFn(),\n    91\t  notFoundComponent: () => <EcranCalme variante=\"introuvable\" />,\n    92\t  staleTime: Number.POSITIVE_INFINITY,\n    93\t});\n    94\t\n    95\t/**\n    96\t * L'écran calme partagé erreur/404 — rendu HORS du LocaleProvider (le\n    97\t * router remplace le composant racine), d'où useRootLocale + le catalogue\n    98\t * lu directement.\n    99\t */\n   100\tfunction EcranCalme({ variante }: { variante: \"souci\" | \"introuvable\" }) {\n   101\t  const m = MESSAGES[useRootLocale()];\n   102\t  return (\n   103\t    <div className={CALM_SCREEN_CLASS}>\n   104\t      <p className=\"text-4xl\">{variante === \"souci\" ? \"🌙\" : \"🐚\"}</p>\n   105\t      <h1 className=\"font-bold text-3xl\">\n   106\t        {variante === \"souci\"\n   107\t          ? m.ecrans.soucisTitre\n   108\t          : m.ecrans.pageIntrouvableTitre}\n   109\t      </h1>\n   110\t      {variante === \"souci\" ? (\n   111\t        <p className=\"text-muted-foreground text-xl\">{m.ecrans.soucisTexte}</p>\n   112\t      ) : null}\n   113\t      <a className=\"text-2xl text-primary underline\" href=\"/\">\n   114\t        {m.ecrans.revenirAccueil}\n   115\t      </a>\n   116\t    </div>\n   117\t  );\n   118\t}\n   119\t\n   120\texport function RootComponent() {\n   121\t  // Shell route-aware (voix extérieure T5) : la couche bureau (portrait,\n   122\t  // bureau, fenêtre) a besoin du plein-bleed ; /parents — hors de l'OS —\n   123\t  // garde le conteneur d'origine. Fonctionne au SSR (l'état du router est\n   124\t  // disponible côté serveur), donc aucun flash de shell.\n   125\t  const estParents = useRouterState({\n   126\t    select: (s) => s.location.pathname.startsWith(\"/parents\"),\n   127\t  });\n   128\t  const locale = useRootLocale();\n   129\t  return (\n   130\t    <RootDocument conteneur={estParents} locale={locale}>\n   131\t      <LocaleProvider locale={locale}>\n   132\t        <Outlet />\n   133\t      </LocaleProvider>\n   134\t    </RootDocument>\n   135\t  );\n   136\t}\n   137\t\n   138\texport function RootDocument({\n   139\t  children,\n   140\t  conteneur,\n   141\t  locale,\n   142\t}: Readonly<{ children: ReactNode; conteneur: boolean; locale: Locale }>) {\n   143\t  return (\n   144\t    <html lang={locale}>\n   145\t      <head>\n   146\t        <HeadContent />\n   147\t      </head>\n   148\t      <body className=\"min-h-screen bg-background text-foreground antialiased\">\n   149\t        {conteneur ? (\n   150\t          <div className=\"mx-auto min-h-screen max-w-5xl px-6 py-10\">\n   151\t            {children}\n   152\t          </div>\n   153\t        ) : (\n   154\t          children\n   155\t        )}\n   156\t        <Toaster />\n   157\t        <Scripts />\n   158\t      </body>\n   159\t    </html>\n   160\t  );\n   161\t}\n     1\t# Build on node (not oven/bun): in oven/bun `node` is a bun shim, so vite/\n     2\t# rolldown resolve with bun semantics — bun treats `ws` as a builtin, the\n     3\t# bundle keeps a bare `import \"ws\"` and the node:22-slim runtime crashes with\n     4\t# ERR_MODULE_NOT_FOUND. bun is only copied in for `bun install` + script runs.\n     5\tFROM node:22-slim AS build\n     6\tCOPY --from=oven/bun:1 /usr/local/bin/bun /usr/local/bin/bun\n     7\tWORKDIR /app\n     8\tCOPY package.json bun.lock ./\n     9\tRUN bun install --frozen-lockfile --ignore-scripts\n    10\tCOPY . .\n    11\t# LEGACY-OPTIONNEL (env→DB, v0.6) : la marque se règle désormais à\n    12\t# /parents/reglages (table app_settings) ; ces args ne servent plus que de\n    13\t# SECOURS pour un déploiement existant qui n'a rien posé en base. Gardés une\n    14\t# release, suppression envisagée ensuite (TODOS.md).\n    15\tARG VITE_CHILD_NAME\n    16\tARG VITE_APP_NAME\n    17\tARG VITE_APP_DESCRIPTION\n    18\tARG VITE_STORY_LABEL\n    19\t# env.ts validates server secrets at import time; skip during build.\n    20\tRUN SKIP_ENV_VALIDATION=1 bun run build\n    21\t\n    22\tFROM node:22-slim\n    23\tWORKDIR /app\n    24\tENV NODE_ENV=production PORT=3009\n    25\t# Secours legacy runtime (mêmes valeurs que les build args) : le serveur lit\n    26\t# process.env.VITE_* quand aucune ligne branding:* n'existe en base.\n    27\tARG VITE_CHILD_NAME\n    28\tARG VITE_APP_NAME\n    29\tARG VITE_APP_DESCRIPTION\n    30\tARG VITE_STORY_LABEL\n    31\tENV VITE_CHILD_NAME=$VITE_CHILD_NAME \\\n    32\t    VITE_APP_NAME=$VITE_APP_NAME \\\n    33\t    VITE_APP_DESCRIPTION=$VITE_APP_DESCRIPTION \\\n    34\t    VITE_STORY_LABEL=$VITE_STORY_LABEL\n    35\tCOPY --from=build /app/.output ./.output\n    36\t# Migrations auto-apply at startup (src/server/db/index.ts) and are resolved\n    37\t# from the CWD — ship the folder next to the server bundle.\n    38\tCOPY --from=build /app/drizzle ./drizzle\n    39\tEXPOSE 3009\n    40\tCMD [\"node\", \".output/server/index.mjs\"]\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/usr/bin/zsh -lc \"nl -ba src/server/dynamic-functions.ts | sed -n '90,380p'; nl -ba src/server/dynamic-functions.ts | sed -n '520,780p'; nl -ba src/server/functions.ts | sed -n '1,190p'; nl -ba src/server/providers/image/nanobanana.ts | sed -n '1,150p'; git diff --check settings-ui-integration...HEAD; diff -u <(rg -o '\"'^[[:space:]]+[A-Za-z0-9_]+:'\"' src/lib/i18n/messages/fr.ts | sed 's/\"'^[[:space:]]*//'\"') <(rg -o '\"'^[[:space:]]+[A-Za-z0-9_]+:'\"' src/lib/i18n/messages/en.ts | sed 's/\"'^[[:space:]]*//'\"') | head -80\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/usr/bin/zsh -lc \"nl -ba src/server/dynamic-functions.ts | sed -n '90,380p'; nl -ba src/server/dynamic-functions.ts | sed -n '520,780p'; nl -ba src/server/functions.ts | sed -n '1,190p'; nl -ba src/server/providers/image/nanobanana.ts | sed -n '1,150p'; git diff --check settings-ui-integration...HEAD; diff -u <(rg -o '\"'^[[:space:]]+[A-Za-z0-9_]+:'\"' src/lib/i18n/messages/fr.ts | sed 's/\"'^[[:space:]]*//'\"') <(rg -o '\"'^[[:space:]]+[A-Za-z0-9_]+:'\"' src/lib/i18n/messages/en.ts | sed 's/\"'^[[:space:]]*//'\"') | head -80\"","aggregated_output":"    90\t    });\n    91\t  }\n    92\t  return history;\n    93\t}\n    94\t\n    95\tfunction beatToSegmentValues(beat: DynamicBeat) {\n    96\t  return {\n    97\t    choices: beat.choices ? toChoices(beat.choices) : null,\n    98\t    paragraphs: beat.paragraphs,\n    99\t    sceneHint: beat.sceneHint ?? null,\n   100\t    status: \"complete\" as const,\n   101\t  };\n   102\t}\n   103\t\n   104\t/**\n   105\t * Start a dynamic story: generate the opening beat, persist the story\n   106\t * (mode=\"dynamic\") + segment 0, return both. Soft-fails to \"On réessaie ?\".\n   107\t */\n   108\texport const startDynamicStoryFn = createServerFn({ method: \"POST\" })\n   109\t  .validator(startSchema)\n   110\t  .handler(async ({ data }): Promise<DynamicStartResult> => {\n   111\t    // UN instantané de config pour TOUTE l'opération (arc + beat + défauts +\n   112\t    // marque) — jamais deux générations de réglages dans une même histoire\n   113\t    // qui démarre.\n   114\t    const config = await getAppConfig();\n   115\t    const { provider } = config;\n   116\t    if (!provider.anthropicApiKey) {\n   117\t      // Point d'usage : clé absente (ni ligne DB ni env) → AUCUN appel\n   118\t      // provider ; l'enfant garde le soft-fail calme existant, le statut\n   119\t      // « clé non configurée » vit côté /parents (app-config features.text).\n   120\t      console.warn(\n   121\t        \"[stories] story start SKIPPED — clé Anthropic non configurée (réglage text:anthropic-api-key / ANTHROPIC_API_KEY)\"\n   122\t      );\n   123\t      return { error: \"On réessaie ?\", success: false };\n   124\t    }\n   125\t    const lang = data.lang ?? provider.defaultLang;\n   126\t    // Heroes + elements DB-backed + editable + multi-select: resolve all chosen.\n   127\t    const [heroes, elements, place, doudous] = await Promise.all([\n   128\t      resolveHeroesForCreation(data.heroIds),\n   129\t      resolveElementsForCreation(data.elementIds),\n   130\t      resolvePlaceForCreation(data.placeId),\n   131\t      resolveDoudousForCreation(data.doudouIds ?? []),\n   132\t    ]);\n   133\t    // HARD-FAIL on an empty resolve (codex #2).\n   134\t    if (heroes.length === 0 || elements.length === 0 || !place) {\n   135\t      return { error: \"Choix invalide.\", success: false };\n   136\t    }\n   137\t\n   138\t    const customPrompt = sanitizeCustomPrompt(data.customPrompt);\n   139\t\n   140\t    // Hidden fil rouge, generated ONCE here and frozen on the story row so\n   141\t    // every beat (incl. continuation/crash-resume) advances along one thread.\n   142\t    // Best-effort: null on failure → the story generates arc-less, as before.\n   143\t    const arcStartedAt = Date.now();\n   144\t    console.log(\"[stories] arc gen START\", {\n   145\t      doudous: doudous.length,\n   146\t      elements: elements.length,\n   147\t      heroes: heroes.length,\n   148\t      lang,\n   149\t    });\n   150\t    const arcResult = await generateStoryArc(\n   151\t      {\n   152\t        customPrompt: customPrompt ?? undefined,\n   153\t        doudous,\n   154\t        elements,\n   155\t        heroes,\n   156\t        lang,\n   157\t        place: { label: place.label, promptHint: place.promptHint },\n   158\t      },\n   159\t      provider\n   160\t    );\n   161\t    const storyArc = arcResult?.arc ?? null;\n   162\t    console.log(\"[stories] arc gen DONE\", {\n   163\t      hasArc: storyArc !== null,\n   164\t      ms: Date.now() - arcStartedAt,\n   165\t      outfit: arcResult?.outfit ?? null,\n   166\t      visualWorld: arcResult?.visualWorld ?? null,\n   167\t    });\n   168\t\n   169\t    const beatStartedAt = Date.now();\n   170\t    console.log(\"[stories] beat gen START\", {\n   171\t      idx: 0,\n   172\t      lang,\n   173\t      mustEnd: false,\n   174\t      storyId: null,\n   175\t    });\n   176\t    let beat: DynamicBeat;\n   177\t    try {\n   178\t      beat = await generateBeat(\n   179\t        {\n   180\t          customPrompt: customPrompt ?? undefined,\n   181\t          doudous,\n   182\t          elements,\n   183\t          heroes,\n   184\t          history: [],\n   185\t          lang,\n   186\t          mustEnd: false,\n   187\t          place: {\n   188\t            emoji: \"\",\n   189\t            id: data.placeId,\n   190\t            label: place.label,\n   191\t            promptHint: place.promptHint,\n   192\t          },\n   193\t          storyArc: storyArc ?? undefined,\n   194\t        },\n   195\t        provider\n   196\t      );\n   197\t    } catch {\n   198\t      // The provider already logged the per-attempt problems.\n   199\t      console.error(\"[stories] beat gen FAILED\", {\n   200\t        idx: 0,\n   201\t        ms: Date.now() - beatStartedAt,\n   202\t        storyId: null,\n   203\t      });\n   204\t      return { error: \"On réessaie ?\", success: false };\n   205\t    }\n   206\t    console.log(\"[stories] beat gen DONE\", {\n   207\t      idx: 0,\n   208\t      ms: Date.now() - beatStartedAt,\n   209\t      storyId: null,\n   210\t    });\n   211\t\n   212\t    const [story] = await db\n   213\t      .insert(stories)\n   214\t      .values({\n   215\t        customPrompt,\n   216\t        doudouImageHint: doudous[0]?.imageHint ?? null,\n   217\t        doudouLabel: doudous[0]?.label ?? null,\n   218\t        doudouPromptHint: doudous[0]?.promptHint ?? null,\n   219\t        // Freeze the doudou snapshot ARRAY (empty when none chosen) so EVERY\n   220\t        // later beat (continuation / crash-resume) re-prompts from it. Mirror\n   221\t        // the FIRST doudou into the singular columns for back-compat readers.\n   222\t        doudouSnapshots: doudous,\n   223\t        elementId: elements[0].id,\n   224\t        elementSnapshots: elements.map((e) => ({\n   225\t          label: e.label,\n   226\t          promptHint: e.promptHint,\n   227\t        })),\n   228\t        // Mirror the FIRST hero/element id into the NOT NULL legacy columns\n   229\t        // (codex #2).\n   230\t        heroId: heroes[0].id,\n   231\t        // Freeze the hero + element snapshot ARRAYS so EVERY later beat\n   232\t        // re-prompts from them (immune to hero/element edits/deletes).\n   233\t        heroSnapshots: heroes.map((h) => ({\n   234\t          imageHint: h.imageHint,\n   235\t          label: h.label,\n   236\t          promptHint: h.promptHint,\n   237\t        })),\n   238\t        lang,\n   239\t        mode: \"dynamic\",\n   240\t        // Frozen with the arc (same call): the heroes' fixed wardrobe for every\n   241\t        // illustration. Null when arc soft-failed / the outfit tripped its own\n   242\t        // safety scan → image prompts keep prior clothing behavior.\n   243\t        outfit: arcResult?.outfit ?? null,\n   244\t        paragraphs: [],\n   245\t        placeId: data.placeId,\n   246\t        // Freeze the place snapshot + custom prompt so EVERY later beat\n   247\t        // (continuation / crash-resume) re-prompts from the same frozen state.\n   248\t        placeLabel: place.label,\n   249\t        placePromptHint: place.promptHint,\n   250\t        storyArc,\n   251\t        // Titre de repli dans la langue de l'HISTOIRE (jamais la locale UI —\n   252\t        // codex #5), depuis la marque du MÊME instantané.\n   253\t        title:\n   254\t          beat.title?.trim() ||\n   255\t          composeBranding(lang, config.branding).storyLabel,\n   256\t        // Frozen with the arc (same call): the story's default illustration\n   257\t        // ambiance. Null when arc gen soft-failed → image prompts as before.\n   258\t        visualWorld: arcResult?.visualWorld ?? null,\n   259\t      })\n   260\t      .returning();\n   261\t\n   262\t    const [segment] = await db\n   263\t      .insert(storySegments)\n   264\t      .values({ idx: 0, storyId: story.id, ...beatToSegmentValues(beat) })\n   265\t      .returning();\n   266\t\n   267\t    // The id only exists post-insert; ties the START/DONE lines above (which\n   268\t    // logged storyId=null) to the created story for grep-ability.\n   269\t    console.log(\"[stories] story created\", {\n   270\t      hasArc: storyArc !== null,\n   271\t      storyId: story.id,\n   272\t      title: story.title,\n   273\t    });\n   274\t    return { segment, storyId: story.id, success: true };\n   275\t  });\n   276\t\n   277\t/**\n   278\t * Continue from a chosen option. Idempotent against double-tap:\n   279\t *  - claim the current beat's choice with a CONDITIONAL update (only when\n   280\t *    chosen_choice_id IS NULL);\n   281\t *  - if the claim affects 0 rows (already chosen), return the already-generated\n   282\t *    next segment instead of generating again;\n   283\t *  - otherwise generate + persist the next beat, forcing the final beat once\n   284\t *    the 5th choice has been made.\n   285\t */\n   286\texport const continueDynamicStoryFn = createServerFn({ method: \"POST\" })\n   287\t  .validator(z.object({ choiceId: z.string(), storyId: z.string() }))\n   288\t  .handler(async ({ data }): Promise<DynamicContinueResult> => {\n   289\t    // UN instantané de config pour toute la continuation.\n   290\t    const { provider } = await getAppConfig();\n   291\t    const segments = await db\n   292\t      .select()\n   293\t      .from(storySegments)\n   294\t      .where(eq(storySegments.storyId, data.storyId))\n   295\t      .orderBy(asc(storySegments.idx));\n   296\t\n   297\t    if (segments.length === 0) {\n   298\t      return { error: \"Histoire introuvable.\", success: false };\n   299\t    }\n   300\t\n   301\t    // The \"current\" beat is the last COMPLETE segment that offers choices — the\n   302\t    // one the child is choosing from. (A trailing `generating`/`error`\n   303\t    // placeholder beyond it is the next beat being (re)generated — crash-resume.)\n   304\t    const current = [...segments]\n   305\t      .reverse()\n   306\t      .find((s) => s.status === \"complete\" && s.choices);\n   307\t    if (!current) {\n   308\t      return { error: \"Cette histoire est déjà terminée.\", success: false };\n   309\t    }\n   310\t    if (!current.choices?.some((c) => c.id === data.choiceId)) {\n   311\t      return { error: \"Choix invalide.\", success: false };\n   312\t    }\n   313\t\n   314\t    const nextIdx = current.idx + 1;\n   315\t\n   316\t    // If the next beat already exists and is COMPLETE, this is a double-tap /\n   317\t    // already-advanced call — return it, never regenerate. A `generating` or\n   318\t    // `error` placeholder is NOT complete: fall through to (re)generate it\n   319\t    // (crash-resume), reusing the choice already recorded — never re-ask.\n   320\t    const findNext = async () => {\n   321\t      const [next] = await db\n   322\t        .select()\n   323\t        .from(storySegments)\n   324\t        .where(\n   325\t          and(\n   326\t            eq(storySegments.storyId, data.storyId),\n   327\t            eq(storySegments.idx, nextIdx)\n   328\t          )\n   329\t        );\n   330\t      return next;\n   331\t    };\n   332\t\n   333\t    const preExisting = await findNext();\n   334\t    if (preExisting && preExisting.status === \"complete\") {\n   335\t      return { segment: preExisting, success: true };\n   336\t    }\n   337\t\n   338\t    // Conditional claim — only sets chosenChoiceId when it's still NULL, so a\n   339\t    // double-tap that races past the check above can't claim twice.\n   340\t    await db\n   341\t      .update(storySegments)\n   342\t      .set({ chosenChoiceId: data.choiceId })\n   343\t      .where(\n   344\t        and(\n   345\t          eq(storySegments.id, current.id),\n   346\t          isNull(storySegments.chosenChoiceId)\n   347\t        )\n   348\t      )\n   349\t      .run();\n   350\t\n   351\t    const story = await db\n   352\t      .select()\n   353\t      .from(stories)\n   354\t      .where(eq(stories.id, data.storyId))\n   355\t      .then((r) => r[0]);\n   356\t    if (!story) {\n   357\t      return { error: \"Histoire introuvable.\", success: false };\n   358\t    }\n   359\t    // History path: hero/place/element FROZEN from the story's own snapshot (or\n   360\t    // immutable config fallback) — never the live, editable DB rows. This\n   361\t    // freezes them across ALL beats incl. crash-resume (codex #1, #4).\n   362\t    const { heroes, place, elements, doudous } =\n   363\t      getFrozenStoryPromptContext(story);\n   364\t    if (heroes.length === 0 || elements.length === 0) {\n   365\t      return { error: \"Histoire introuvable.\", success: false };\n   366\t    }\n   367\t\n   368\t    // Count persisted chosen choices (the claim above is now persisted). The\n   369\t    // 5th choice ends the story: at 5 chosen choices the next beat must be final.\n   370\t    const chosenCount = segments.filter(\n   371\t      (s) => s.id === current.id || s.chosenChoiceId\n   372\t    ).length;\n   373\t    const mustEnd = chosenCount >= MAX_CHOICES;\n   374\t\n   375\t    // Reserve the next beat as `generating` with the pending choice, so a crash\n   376\t    // mid-generation leaves a recoverable marker (status + pendingChoiceId).\n   377\t    // Idempotent: UNIQUE(story_id, idx) means a racing caller can't double-insert\n   378\t    // — on conflict we reuse the existing placeholder row.\n   379\t    let placeholder = preExisting;\n   380\t    if (placeholder) {\n   520\t * process, closing that race. Cleared once the shared promise settles.\n   521\t */\n   522\tconst inFlightSegmentImages = new Map<string, Promise<ImageResult>>();\n   523\t\n   524\t/**\n   525\t * Generate the illustration for ONE segment (only when IMAGE_ENABLED).\n   526\t * Idempotent: if this segment already has an image, no-op (prevents repeated\n   527\t * Gemini spend on route remounts). Fails soft — image is always optional.\n   528\t */\n   529\texport const generateSegmentImageFn = createServerFn({ method: \"POST\" })\n   530\t  .validator(\n   531\t    z.object({\n   532\t      idx: z.number(),\n   533\t      imageModel: z.string().optional(),\n   534\t      storyId: z.string(),\n   535\t    })\n   536\t  )\n   537\t  .handler(async ({ data }): Promise<ImageResult> => {\n   538\t    const startedAt = Date.now();\n   539\t    // UN instantané de config pour toute l'opération (gate + clé + modèle +\n   540\t    // résolution du même monde).\n   541\t    const { provider } = await getAppConfig();\n   542\t    // Resolve the parent-picked model against the allowlist (loud fallback log\n   543\t    // on an unknown id); the START log prints the RESOLVED model.\n   544\t    const model = resolveImageModel(data.imageModel, provider.imageModel);\n   545\t    console.log(\"[stories] image gen START\", {\n   546\t      idx: data.idx,\n   547\t      model,\n   548\t      resolution: provider.imageResolution,\n   549\t      storyId: data.storyId,\n   550\t    });\n   551\t    if (!provider.imageEnabled) {\n   552\t      console.warn(\n   553\t        \"[stories] image gen SKIPPED — images désactivées (réglage image:enabled / IMAGE_ENABLED)\"\n   554\t      );\n   555\t      return { imagePath: null, imageStatus: \"skipped\" };\n   556\t    }\n   557\t\n   558\t    // Server-side single-flight: collapse concurrent calls for this segment onto\n   559\t    // ONE generation promise so two requests racing past the DB `imagePath` check\n   560\t    // (which only dedupes sequential calls) can't both bill Gemini.\n   561\t    const key = `${data.storyId}:${data.idx}`;\n   562\t    const existing = inFlightSegmentImages.get(key);\n   563\t    if (existing) {\n   564\t      console.warn(\"[stories] image gen deduped (already in-flight, server)\", {\n   565\t        key,\n   566\t      });\n   567\t      return existing;\n   568\t    }\n   569\t    const run = generateSegmentImage(\n   570\t      data.storyId,\n   571\t      data.idx,\n   572\t      startedAt,\n   573\t      model,\n   574\t      provider\n   575\t    );\n   576\t    inFlightSegmentImages.set(key, run);\n   577\t    return await run.finally(() => inFlightSegmentImages.delete(key));\n   578\t  });\n   579\t\n   580\t/**\n   581\t * Parent/child-triggered RETRY of a single beat's illustration after it landed\n   582\t * on the calm \"no drawing today\" (`__failed__`) state. Unlike the normal fetch\n   583\t * this is EXPLICIT and intentional: it clears ONLY the failure sentinel and\n   584\t * re-runs the exact same prompt-building + nanobanana gen + persist path, so the\n   585\t * one image can be re-attempted on demand. A real, already-stored image is never\n   586\t * overwritten (force is sentinel-only). Still gated behind IMAGE_ENABLED (the\n   587\t * single cost gate) and deduped through the same in-flight map as the normal\n   588\t * fetch, so a double-tap (or a racing background fetch) shares one billed call.\n   589\t */\n   590\texport const retrySegmentImageFn = createServerFn({ method: \"POST\" })\n   591\t  .validator(\n   592\t    z.object({\n   593\t      idx: z.number(),\n   594\t      imageModel: z.string().optional(),\n   595\t      storyId: z.string(),\n   596\t    })\n   597\t  )\n   598\t  .handler(async ({ data }): Promise<ImageResult> => {\n   599\t    const startedAt = Date.now();\n   600\t    // UN instantané de config pour toute l'opération.\n   601\t    const { provider } = await getAppConfig();\n   602\t    const model = resolveImageModel(data.imageModel, provider.imageModel);\n   603\t    console.log(\"[stories] image RETRY START\", {\n   604\t      idx: data.idx,\n   605\t      model,\n   606\t      resolution: provider.imageResolution,\n   607\t      storyId: data.storyId,\n   608\t    });\n   609\t    if (!provider.imageEnabled) {\n   610\t      console.warn(\n   611\t        \"[stories] image retry SKIPPED — images désactivées (réglage image:enabled / IMAGE_ENABLED)\"\n   612\t      );\n   613\t      return { imagePath: null, imageStatus: \"skipped\" };\n   614\t    }\n   615\t\n   616\t    // Share the same single-flight slot as the normal fetch so a double-click —\n   617\t    // or a retry racing a background fetch for this beat — collapses onto ONE\n   618\t    // billed Gemini call rather than two.\n   619\t    const key = `${data.storyId}:${data.idx}`;\n   620\t    const existing = inFlightSegmentImages.get(key);\n   621\t    if (existing) {\n   622\t      console.warn(\n   623\t        \"[stories] image retry deduped (already in-flight, server)\",\n   624\t        {\n   625\t          key,\n   626\t        }\n   627\t      );\n   628\t      return existing;\n   629\t    }\n   630\t    const run = generateSegmentImage(\n   631\t      data.storyId,\n   632\t      data.idx,\n   633\t      startedAt,\n   634\t      model,\n   635\t      provider,\n   636\t      true\n   637\t    );\n   638\t    inFlightSegmentImages.set(key, run);\n   639\t    return await run.finally(() => inFlightSegmentImages.delete(key));\n   640\t  });\n   641\t\n   642\t/**\n   643\t * Resolve a prior illustration of the SAME story to use as the consistency\n   644\t * reference for the next one. Picks the EARLIEST renderable image (usually beat\n   645\t * 0) as the canonical character/style anchor — chaining each image off the\n   646\t * previous one would compound drift instead of preventing it.\n   647\t *\n   648\t * Returns raw bytes, or undefined (beat 0 / nothing renderable yet / read\n   649\t * failure) — in which case the caller falls back to plain text-to-image.\n   650\t *\n   651\t * The `/`-prefix (local) vs `https://` (blob) storage rule — incl. the blob\n   652\t * host ALLOWLIST and the media-dir escape rejection — lives ENTIRELY in\n   653\t * `resolveStoredMediaForModel` (media-store, the single media choke-point);\n   654\t * this function only picks WHICH stored row anchors the story.\n   655\t *\n   656\t * The blob bytes are DOWNLOADED HERE, inside the best-effort try/catch, with a\n   657\t * bounded timeout — never handed to the AI SDK as a URL. A deleted/unreachable\n   658\t * anchor blob must degrade to plain text-to-image for that beat, NOT throw\n   659\t * inside generateImage and persist the TERMINAL failure sentinel (which, since\n   660\t * every beat anchors on the same earliest image, would kill every later\n   661\t * illustration of the story with no working retry).\n   662\t */\n   663\tasync function resolveReferenceImage(\n   664\t  storyId: string,\n   665\t  idx: number\n   666\t): Promise<Uint8Array | undefined> {\n   667\t  if (idx <= 0) {\n   668\t    return;\n   669\t  }\n   670\t  try {\n   671\t    // Earliest renderable prior image, filtered in SQL: one row, one column.\n   672\t    const [anchor] = await db\n   673\t      .select({ imagePath: storySegments.imagePath })\n   674\t      .from(storySegments)\n   675\t      .where(\n   676\t        and(\n   677\t          eq(storySegments.storyId, storyId),\n   678\t          lt(storySegments.idx, idx),\n   679\t          isNotNull(storySegments.imagePath),\n   680\t          ne(storySegments.imagePath, IMAGE_FAILED_SENTINEL)\n   681\t        )\n   682\t      )\n   683\t      .orderBy(asc(storySegments.idx))\n   684\t      .limit(1);\n   685\t    const path = anchor?.imagePath;\n   686\t    if (!path) {\n   687\t      return;\n   688\t    }\n   689\t    return await resolveStoredMediaForModel(path);\n   690\t  } catch (error) {\n   691\t    // Best-effort only: a missing local file / DB hiccup must never fail the\n   692\t    // image itself — generate without a reference instead.\n   693\t    console.warn(\n   694\t      `[stories] reference image unavailable for story ${storyId} idx=${idx}:`,\n   695\t      error instanceof Error ? error.message : String(error)\n   696\t    );\n   697\t  }\n   698\t}\n   699\t\n   700\t/**\n   701\t * The actual segment-image generation, deduped by `generateSegmentImageFn` /\n   702\t * `retrySegmentImageFn`. `force` (retry only) clears a prior `__failed__`\n   703\t * sentinel so a settled failure can be re-attempted; a real stored image is\n   704\t * still treated as a no-op (never overwritten / re-billed).\n   705\t */\n   706\tasync function generateSegmentImage(\n   707\t  storyId: string,\n   708\t  idx: number,\n   709\t  startedAt: number,\n   710\t  model: string,\n   711\t  provider: ProviderConfig,\n   712\t  force = false\n   713\t): Promise<ImageResult> {\n   714\t  const [segment] = await db\n   715\t    .select()\n   716\t    .from(storySegments)\n   717\t    .where(and(eq(storySegments.storyId, storyId), eq(storySegments.idx, idx)));\n   718\t  if (!segment) {\n   719\t    return { imagePath: null, imageStatus: \"skipped\" };\n   720\t  }\n   721\t  // A forced retry re-attempts ONLY a prior failure sentinel — a real stored\n   722\t  // path is always a no-op (don't overwrite / re-bill an existing illustration).\n   723\t  if (segment.imagePath && segment.imagePath !== IMAGE_FAILED_SENTINEL) {\n   724\t    return resolveStoredImagePath(segment.imagePath);\n   725\t  }\n   726\t  if (segment.imagePath === IMAGE_FAILED_SENTINEL && !force) {\n   727\t    // Idempotent no-op: the terminal failure sentinel → \"failed\" (a prior\n   728\t    // attempt already failed — do NOT re-bill Gemini, do NOT re-hang the child;\n   729\t    // the calm \"no drawing\" state is final for this beat unless explicitly\n   730\t    // retried via `retrySegmentImageFn`).\n   731\t    return resolveStoredImagePath(segment.imagePath);\n   732\t  }\n   733\t\n   734\t  const [story] = await db\n   735\t    .select()\n   736\t    .from(stories)\n   737\t    .where(eq(stories.id, storyId));\n   738\t  if (!story) {\n   739\t    return { imagePath: null, imageStatus: \"skipped\" };\n   740\t  }\n   741\t  // History path: frozen snapshot, never the live editable rows.\n   742\t  const frozen = getFrozenStoryPromptContext(story);\n   743\t\n   744\t  // A prior illustration of THIS story, sent as an image input so characters/\n   745\t  // style stay consistent across beats (best-effort — null on beat 0 / no\n   746\t  // prior image / fetch failure → plain text-to-image, as before).\n   747\t  const referenceImage = await resolveReferenceImage(storyId, idx);\n   748\t\n   749\t  // The illustration prompt (scene · ambiance · outfit · heroes · doudou ·\n   750\t  // style) is assembled by the pure builder — pinned byte-identical by\n   751\t  // test:golden. This function keeps only DB read / persist / sentinel.\n   752\t  const prompt = buildSegmentImagePrompt(\n   753\t    story,\n   754\t    segment,\n   755\t    referenceImage !== undefined,\n   756\t    frozen,\n   757\t    // La langue de l'histoire (colonne row, non typée) — une valeur inconnue\n   758\t    // retombe sur le prompt français historique, jamais une erreur.\n   759\t    langSchema.catch(\"fr\").parse(story.lang)\n   760\t  );\n   761\t\n   762\t  try {\n   763\t    const imagePath = await generateImage(\n   764\t      prompt,\n   765\t      provider,\n   766\t      model,\n   767\t      referenceImage\n   768\t    );\n   769\t    await db\n   770\t      .update(storySegments)\n   771\t      .set({ imagePath })\n   772\t      .where(eq(storySegments.id, segment.id));\n   773\t    console.log(\"[stories] image gen DONE\", {\n   774\t      idx,\n   775\t      imagePath,\n   776\t      ms: Date.now() - startedAt,\n   777\t      storyId,\n   778\t    });\n   779\t    return { imagePath, imageStatus: \"ready\" };\n   780\t  } catch (error) {\n     1\timport { createServerFn } from \"@tanstack/react-start\";\n     2\timport { and, desc, eq } from \"drizzle-orm\";\n     3\timport { z } from \"zod\";\n     4\timport { resolveImageModel } from \"~/config/image-models\";\n     5\timport { getAppConfig, publicFlagsFromConfig } from \"~/server/app-config\";\n     6\timport { db } from \"~/server/db\";\n     7\timport { stories } from \"~/server/db/schema\";\n     8\timport { generateImage } from \"~/server/providers/image/nanobanana\";\n     9\timport { getTtsProvider } from \"~/server/providers/tts\";\n    10\timport type { ImageStatus } from \"~/server/providers/types\";\n    11\t\n    12\t/** Flags the client may read (no secrets) — dérivés de l'instantané de\n    13\t * config : un toggle posé en base s'applique au prochain chargement, sans\n    14\t * rebuild. */\n    15\texport const getFlagsFn = createServerFn({ method: \"GET\" }).handler(\n    16\t  async () => {\n    17\t    const config = await getAppConfig();\n    18\t    return publicFlagsFromConfig(config.provider);\n    19\t  }\n    20\t);\n    21\t\n    22\t/**\n    23\t * Outcome of the /parents test-playground generation. Unlike the story-bound\n    24\t * `ImageResult` it also carries the RESOLVED `model` + elapsed `ms` so the\n    25\t * parent can compare models side by side (2.5 vs 3.1 vs pro) on one screen.\n    26\t */\n    27\texport interface TestImageResult {\n    28\t  imagePath: string | null;\n    29\t  imageStatus: ImageStatus;\n    30\t  model: string;\n    31\t  ms: number;\n    32\t}\n    33\t\n    34\t/**\n    35\t * Parent-only test playground (from /parents/image-model): generate ONE image\n    36\t * from a free-text prompt with a chosen model so the parent can compare quality\n    37\t * / price / speed live. Intentionally billed — user-driven by a button click.\n    38\t * No story row, no DB write: the provider's `saveMedia` already persists the\n    39\t * file under data/media and returns its web path. Still behind IMAGE_ENABLED so\n    40\t * images can never generate when globally off (single cost gate).\n    41\t *\n    42\t * Calm-tool note: this is a PARENT control — the child flow is untouched.\n    43\t */\n    44\texport const generateTestImageFn = createServerFn({ method: \"POST\" })\n    45\t  .validator(\n    46\t    z.object({\n    47\t      imageModel: z.string().optional(),\n    48\t      prompt: z.string().min(1).max(2000),\n    49\t    })\n    50\t  )\n    51\t  .handler(async ({ data }): Promise<TestImageResult> => {\n    52\t    // UN instantané de config pour toute l'opération (gate + clé + modèle +\n    53\t    // résolution du même monde — jamais deux générations mélangées).\n    54\t    const { provider } = await getAppConfig();\n    55\t    // Resolve the picked model against the allowlist (loud fallback log on an\n    56\t    // unknown id) so a stale/tampered value can never reach the provider.\n    57\t    const model = resolveImageModel(data.imageModel, provider.imageModel);\n    58\t    if (!provider.imageEnabled) {\n    59\t      console.warn(\n    60\t        \"[stories] test image gen SKIPPED — images désactivées (réglage image:enabled / IMAGE_ENABLED)\"\n    61\t      );\n    62\t      return { imagePath: null, imageStatus: \"skipped\", model, ms: 0 };\n    63\t    }\n    64\t    if (!provider.geminiApiKey) {\n    65\t      // Point d'usage : clé absente → aucun appel réseau, état calme. Le\n    66\t      // statut « clé non configurée » vient de app-config (features.image).\n    67\t      console.warn(\n    68\t        \"[stories] test image gen SKIPPED — clé Gemini non configurée (réglage image:gemini-api-key / GEMINI_API_KEY)\"\n    69\t      );\n    70\t      return { imagePath: null, imageStatus: \"skipped\", model, ms: 0 };\n    71\t    }\n    72\t\n    73\t    const startedAt = Date.now();\n    74\t    console.log(\"[stories] test image gen START\", {\n    75\t      model,\n    76\t      promptLen: data.prompt.length,\n    77\t      resolution: provider.imageResolution,\n    78\t    });\n    79\t\n    80\t    try {\n    81\t      // Send the prompt AS-IS — the parent has full control (no style suffix\n    82\t      // auto-append; the playground prefill already carries it).\n    83\t      const imagePath = await generateImage(data.prompt, provider, model);\n    84\t      const ms = Date.now() - startedAt;\n    85\t      console.log(\"[stories] test image gen DONE\", { imagePath, model, ms });\n    86\t      return { imagePath, imageStatus: \"ready\", model, ms };\n    87\t    } catch (error) {\n    88\t      const ms = Date.now() - startedAt;\n    89\t      // Non-silent: log the real reason (model + cause) so the operator sees a\n    90\t      // Gemini billing/quota denial; the parent gets a calm inline message.\n    91\t      console.error(\n    92\t        `[stories] test image generation FAILED (model=${model}, ms=${ms}): ` +\n    93\t          (error instanceof Error ? error.message : String(error))\n    94\t      );\n    95\t      return { imagePath: null, imageStatus: \"failed\", model, ms };\n    96\t    }\n    97\t  });\n    98\t\n    99\t/**\n   100\t * Synthesize the story audio (only when TTS_ENABLED). Cached on the row so a\n   101\t * re-listen doesn't regenerate.\n   102\t */\n   103\texport const synthesizeFn = createServerFn({ method: \"POST\" })\n   104\t  .validator(z.object({ id: z.string() }))\n   105\t  .handler(async ({ data }): Promise<{ audioPath: string | null }> => {\n   106\t    // UN instantané pour l'opération : gate + provider + clé du même monde.\n   107\t    const { provider } = await getAppConfig();\n   108\t    if (!provider.ttsEnabled) {\n   109\t      return { audioPath: null };\n   110\t    }\n   111\t\n   112\t    const [story] = await db\n   113\t      .select()\n   114\t      .from(stories)\n   115\t      .where(eq(stories.id, data.id));\n   116\t    if (!story) {\n   117\t      return { audioPath: null };\n   118\t    }\n   119\t    if (story.audioPath) {\n   120\t      return { audioPath: story.audioPath };\n   121\t    }\n   122\t\n   123\t    const tts = getTtsProvider(provider);\n   124\t\n   125\t    const fullText = [story.title, ...story.paragraphs].join(\". \");\n   126\t\n   127\t    try {\n   128\t      const audioPath = await tts.synthesize(\n   129\t        fullText,\n   130\t        story.lang === \"ru\" || story.lang === \"en\" ? story.lang : \"fr\"\n   131\t      );\n   132\t      await db\n   133\t        .update(stories)\n   134\t        .set({ audioPath })\n   135\t        .where(eq(stories.id, data.id));\n   136\t      return { audioPath };\n   137\t    } catch {\n   138\t      return { audioPath: null };\n   139\t    }\n   140\t  });\n   141\t\n   142\t/**\n   143\t * Kept stories, newest first — for the library. Only DYNAMIC stories appear:\n   144\t * the classic viewer is gone, so old classic rows are simply never listed\n   145\t * (no dead tiles, no broken taps).\n   146\t */\n   147\texport const getLibraryFn = createServerFn({ method: \"GET\" }).handler(() =>\n   148\t  db\n   149\t    .select()\n   150\t    .from(stories)\n   151\t    .where(and(eq(stories.kept, \"1\"), eq(stories.mode, \"dynamic\")))\n   152\t    .orderBy(desc(stories.createdAt))\n   153\t);\n     1\timport { createGoogleGenerativeAI } from \"@ai-sdk/google\";\n     2\timport { generateText } from \"ai\";\n     3\timport { generateId } from \"~/lib/id-generator\";\n     4\timport type { ProviderConfig } from \"~/server/app-config\";\n     5\timport { saveMedia } from \"~/server/providers/media-store\";\n     6\t\n     7\t// Gemini image models bill per OUTPUT token at $30 / 1M tokens; a standard\n     8\t// (<=1024px) image is ~1290 output tokens ≈ $0.039/image. We estimate cost from\n     9\t// the usage tokens the SDK returns, falling back to a flat per-image price.\n    10\t// Source: https://ai.google.dev/gemini-api/docs/pricing (2026-06).\n    11\tconst IMAGE_USD_PER_OUTPUT_TOKEN = 30 / 1_000_000;\n    12\tconst IMAGE_USD_PER_IMAGE = 0.039;\n    13\t\n    14\t/**\n    15\t * Nano Banana = Google's gemini image family, accessed through the Gemini API\n    16\t * via the Vercel AI SDK's Google provider. The model returns image files\n    17\t * inline; we persist the first one under DATA_DIR and return its web path. The\n    18\t * `model` arg (already allowlist-resolved by the caller) overrides the env\n    19\t * default per request so a parent can compare models; all offered models share\n    20\t * this exact call shape, so only the model-id arg changes.\n    21\t *\n    22\t * Behind IMAGE_ENABLED — the caller decides whether to invoke this at all.\n    23\t *\n    24\t * COST: Gemini image models bill per OUTPUT token and are resolution-tiered, so\n    25\t * we pin a LOW output resolution via `providerOptions.google.imageConfig`\n    26\t * (`imageSize` from `IMAGE_RESOLUTION`, default \"1K\") + `aspectRatio: \"4:3\"` to\n    27\t * match the modest 4/3 display container (no wasted pixels, no crop). These are\n    28\t * the @ai-sdk/google `imageConfig` schema fields. A model that doesn't support\n    29\t * imageConfig (e.g. gemini-2.5-flash-image) just ignores it — no crash.\n    30\t *\n    31\t * CONSISTENCY: `referenceImage` (a prior illustration of the SAME story — blob\n    32\t * URL or local bytes) is sent as an IMAGE INPUT alongside the text prompt, the\n    33\t * standard Gemini-image technique for keeping characters/style stable across\n    34\t * independently-generated scenes. Without it every beat reinvented the\n    35\t * characters (hair color, clothes, age drifted page to page). Input images\n    36\t * bill as INPUT tokens (cheap) — the expensive part stays the output image.\n    37\t *\n    38\t * This is the app's SOLE image generation entry point (a plain module\n    39\t * function, imported by concrete name; there is deliberately no provider\n    40\t * interface — see the adapter-census note in `types.ts`). `model` overrides\n    41\t * the env default for THIS request (parent-pickable model; already\n    42\t * allowlist-resolved by the caller). `referenceImage` (URL for blob-hosted,\n    43\t * bytes for local-disk media) is a prior illustration of the SAME story, sent\n    44\t * alongside the prompt so the model keeps the characters/style consistent\n    45\t * across beats. Omitted → pure text-to-image (opening beat, or no prior image\n    46\t * available).\n    47\t */\n    48\texport async function generateImage(\n    49\t  prompt: string,\n    50\t  // L'INSTANTANÉ de config de l'opération (clé + résolution + modèle par\n    51\t  // défaut) — pris à la frontière de la server function, jamais relu ici.\n    52\t  config: ProviderConfig,\n    53\t  model?: string,\n    54\t  referenceImage?: Uint8Array | URL\n    55\t): Promise<string> {\n    56\t  if (!config.geminiApiKey) {\n    57\t    // Clé absente (ni ligne DB ni env) : AUCUN appel réseau — le beat garde\n    58\t    // son état calme « pas de dessin », le statut vit côté /parents.\n    59\t    throw new Error(\"Clé Gemini non configurée.\");\n    60\t  }\n    61\t\n    62\t  const google = createGoogleGenerativeAI({ apiKey: config.geminiApiKey });\n    63\t\n    64\t  const providerOptions = {\n    65\t    google: {\n    66\t      // Pin a low, display-matched output to cut cost (see header).\n    67\t      imageConfig: {\n    68\t        aspectRatio: \"4:3\",\n    69\t        imageSize: config.imageResolution,\n    70\t      },\n    71\t      responseModalities: [\"IMAGE\"],\n    72\t    },\n    73\t  };\n    74\t\n    75\t  const result = await generateText({\n    76\t    // A stalled Gemini call must fail (→ calm \"no drawing\" state) rather\n    77\t    // than hold the request open past any client reveal timeout.\n    78\t    abortSignal: AbortSignal.timeout(90_000),\n    79\t    model: google(model ?? config.imageModel),\n    80\t    ...(referenceImage\n    81\t      ? {\n    82\t          messages: [\n    83\t            {\n    84\t              content: [\n    85\t                { image: referenceImage, type: \"image\" as const },\n    86\t                { text: prompt, type: \"text\" as const },\n    87\t              ],\n    88\t              role: \"user\" as const,\n    89\t            },\n    90\t          ],\n    91\t        }\n    92\t      : { prompt }),\n    93\t    providerOptions,\n    94\t  });\n    95\t\n    96\t  const imageFile = result.files.find((f) => f.mediaType?.startsWith(\"image/\"));\n    97\t  if (!imageFile) {\n    98\t    throw new Error(\"Aucune image renvoyée par le générateur d'image.\");\n    99\t  }\n   100\t\n   101\t  const usedModel = model ?? config.imageModel;\n   102\t  console.log(\n   103\t    `[image-gen] model=${usedModel} ref=${referenceImage ? \"yes\" : \"no\"} prompt=${prompt}`\n   104\t  );\n   105\t  try {\n   106\t    const outTokens = result.usage?.outputTokens;\n   107\t    const cost =\n   108\t      outTokens === undefined\n   109\t        ? IMAGE_USD_PER_IMAGE\n   110\t        : outTokens * IMAGE_USD_PER_OUTPUT_TOKEN;\n   111\t    const basis =\n   112\t      outTokens === undefined\n   113\t        ? \"flat per-image estimate\"\n   114\t        : `${outTokens} output tokens @ $30/1M`;\n   115\t    console.log(`[image-gen] cost≈$${cost.toFixed(4)} (${basis})`);\n   116\t  } catch {\n   117\t    // Never let cost logging break image generation.\n   118\t  }\n   119\t\n   120\t  const ext = imageFile.mediaType === \"image/jpeg\" ? \"jpg\" : \"png\";\n   121\t  const filename = `${generateId(\"img\")}.${ext}`;\n   122\t  return saveMedia(filename, imageFile.uint8Array);\n   123\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_11","type":"agent_message","text":"So far, the implementation genuinely fixes most earlier design blockers: provider boot validation is gone, secret masking/reset are distinct, config reads are uncached, provider calls receive one snapshot, branding uses frozen story language, and writes use field patches. I’m stress-checking the remaining edges now—especially UI state after invalidation, transaction/readback behavior, generated client boundaries, and Docker runtime fallback."}}
