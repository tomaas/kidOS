{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/usr/bin/zsh -lc \"nl -ba src/server/app-config.ts | sed -n '1,680p'; nl -ba src/server/settings-functions.ts | sed -n '1,260p'; rg -n \\\"createServerFn|getAppConfig|serverEnv|envFallbackConfig|AppConfig|ProviderConfig\\\" src/server src/app src/components --glob '*.ts' --glob '*.tsx'\"","aggregated_output":"     1\t/**\n     2\t * Réglages applicatifs — le POINT DE PASSAGE UNIQUE (même philosophie que\n     3\t * media-store.ts) entre la table `app_settings`, l'environnement et les\n     4\t * défauts du code.\n     5\t *\n     6\t * Précédence de lecture : ligne DB présente → elle gagne ; absente → valeur\n     7\t * d'environnement → défaut du code. Les valeurs DB invalides (booléen ou enum\n     8\t * corrompu à la main) retombent sur le fallback (« invalid means FALLBACK »,\n     9\t * jamais « invalid means disabled ») — une ligne bricolée ne désactive\n    10\t * jamais une fonctionnalité en silence.\n    11\t *\n    12\t * SECRETS : une ligne présente gagne MÊME vide — la chaîne vide est le\n    13\t * « masque explicite » (l'Effacer honnête : la clé d'env est neutralisée).\n    14\t * Supprimer la ligne = revenir au réglage du déploiement (l'env reprend).\n    15\t * Quatre opérations donc : conserver (pas d'écriture) / définir / masquer\n    16\t * (ligne \"\") / réinitialiser (suppression de ligne).\n    17\t *\n    18\t * PAS de cache : ~14 lignes dans un fichier SQLite local — chaque opération\n    19\t * logique prend UN instantané frais à la frontière de la server function et\n    20\t * le fait descendre (jamais deux générations de config dans une même\n    21\t * opération).\n    22\t *\n    23\t * RÈGLE D'IMPORT (critique pour les goldens) : ce module n'importe JAMAIS\n    24\t * `~/server/db` au niveau module — import dynamique dans les fonctions de\n    25\t * lecture/écriture uniquement. Importer app-config.ts (ou un provider qui\n    26\t * l'importe) ne doit ni ouvrir ni créer la base. Épinglé par test:settings.\n    27\t */\n    28\t\n    29\timport { eq } from \"drizzle-orm\";\n    30\timport { serverEnv } from \"~/env\";\n    31\t// schema.ts est sans effet de bord (définitions Drizzle pures) — seul\n    32\t// ~/server/db (index) ouvre le client et migre ; lui reste en import lazy.\n    33\timport { appSettings } from \"~/server/db/schema\";\n    34\t\n    35\t// ── Clés canoniques ───────────────────────────────────────────────────────────\n    36\t\n    37\t/** Liste canonique gelée — la seule vérité des clés `app_settings` posables\n    38\t * depuis /parents/reglages. Kebab-case, préfixe de section. */\n    39\texport const SETTING_KEYS = [\n    40\t  \"text:anthropic-api-key\",\n    41\t  \"text:story-model\",\n    42\t  \"image:enabled\",\n    43\t  \"image:gemini-api-key\",\n    44\t  \"image:model\",\n    45\t  \"image:resolution\",\n    46\t  \"tts:enabled\",\n    47\t  \"tts:provider\",\n    48\t  \"tts:elevenlabs-api-key\",\n    49\t  \"story:default-lang\",\n    50\t  \"branding:child-name\",\n    51\t  \"branding:app-name\",\n    52\t  \"branding:app-description\",\n    53\t  \"branding:story-label\",\n    54\t] as const;\n    55\t\n    56\texport type SettingKey = (typeof SETTING_KEYS)[number];\n    57\t\n    58\t/** Clés dont la valeur est un secret : jamais renvoyée au client. */\n    59\texport const SECRET_SETTING_KEYS = [\n    60\t  \"text:anthropic-api-key\",\n    61\t  \"image:gemini-api-key\",\n    62\t  \"tts:elevenlabs-api-key\",\n    63\t] as const satisfies readonly SettingKey[];\n    64\t\n    65\texport function isSecretSettingKey(key: string): boolean {\n    66\t  return (SECRET_SETTING_KEYS as readonly string[]).includes(key);\n    67\t}\n    68\t\n    69\t/** La clé historique de la locale d'interface (settings-functions.ts) —\n    70\t * écrite via les mêmes helpers centraux, mais hors de AppConfig (elle est\n    71\t * lue par le loader racine, pas par les providers). */\n    72\texport const UI_LANGUAGE_KEY = \"ui-language\";\n    73\t\n    74\tconst WRITABLE_KEYS: readonly string[] = [...SETTING_KEYS, UI_LANGUAGE_KEY];\n    75\t\n    76\t// ── Forme typée (gelée depuis le chunk 1 — les chunks suivants ajoutent des\n    77\t//    consommateurs, jamais une nouvelle forme) ────────────────────────────────\n    78\t\n    79\texport type ImageResolution = \"512\" | \"1K\" | \"2K\" | \"4K\";\n    80\texport type TtsProviderName = \"edge\" | \"elevenlabs\";\n    81\texport type StoryLang = \"fr\" | \"ru\" | \"en\";\n    82\t\n    83\texport interface ProviderConfig {\n    84\t  anthropicApiKey: string;\n    85\t  defaultLang: StoryLang;\n    86\t  elevenLabsApiKey: string;\n    87\t  geminiApiKey: string;\n    88\t  imageEnabled: boolean;\n    89\t  imageModel: string;\n    90\t  imageResolution: ImageResolution;\n    91\t  storyModel: string;\n    92\t  ttsEnabled: boolean;\n    93\t  ttsProvider: TtsProviderName;\n    94\t}\n    95\t\n    96\t/** Valeurs de marque BRUTES (\"\" = non défini) — la dérivation (élision\n    97\t * française, possessif anglais) reste dans la pure buildBranding. */\n    98\texport interface BrandingConfig {\n    99\t  appDescription: string;\n   100\t  appName: string;\n   101\t  childName: string;\n   102\t  storyLabel: string;\n   103\t}\n   104\t\n   105\texport interface AppConfig {\n   106\t  branding: BrandingConfig;\n   107\t  provider: ProviderConfig;\n   108\t}\n   109\t\n   110\t// ── Fallback env (serverEnv + VITE_* runtime) ────────────────────────────────\n   111\t\n   112\tconst IMAGE_RESOLUTIONS: readonly ImageResolution[] = [\"512\", \"1K\", \"2K\", \"4K\"];\n   113\tconst TTS_PROVIDERS: readonly TtsProviderName[] = [\"edge\", \"elevenlabs\"];\n   114\tconst STORY_LANGS: readonly StoryLang[] = [\"fr\", \"ru\", \"en\"];\n   115\t\n   116\t/** VITE_* legacy en secours : process.env (runtime — Docker/­dev shell)\n   117\t * d'abord, puis la valeur BAKÉE au build (import.meta.env — l'ancien canal),\n   118\t * pour qu'un déploiement existant garde exactement sa marque. */\n   119\tfunction viteFallback(runtime: string | undefined, baked: unknown): string {\n   120\t  return runtime ?? (typeof baked === \"string\" ? baked : \"\");\n   121\t}\n   122\t\n   123\t/**\n   124\t * La config « env seulement » : ce que l'app ferait sans aucune ligne DB.\n   125\t */\n   126\texport function envFallbackConfig(): AppConfig {\n   127\t  return Object.freeze({\n   128\t    branding: Object.freeze({\n   129\t      appDescription: viteFallback(\n   130\t        process.env.VITE_APP_DESCRIPTION,\n   131\t        import.meta.env.VITE_APP_DESCRIPTION\n   132\t      ),\n   133\t      appName: viteFallback(\n   134\t        process.env.VITE_APP_NAME,\n   135\t        import.meta.env.VITE_APP_NAME\n   136\t      ),\n   137\t      childName: viteFallback(\n   138\t        process.env.VITE_CHILD_NAME,\n   139\t        import.meta.env.VITE_CHILD_NAME\n   140\t      ),\n   141\t      storyLabel: viteFallback(\n   142\t        process.env.VITE_STORY_LABEL,\n   143\t        import.meta.env.VITE_STORY_LABEL\n   144\t      ),\n   145\t    }),\n   146\t    provider: Object.freeze({\n   147\t      anthropicApiKey: serverEnv.anthropicApiKey,\n   148\t      defaultLang: serverEnv.defaultLang,\n   149\t      elevenLabsApiKey: serverEnv.elevenLabsApiKey,\n   150\t      geminiApiKey: serverEnv.geminiApiKey,\n   151\t      imageEnabled: serverEnv.imageEnabled,\n   152\t      imageModel: serverEnv.imageModel,\n   153\t      imageResolution: serverEnv.imageResolution,\n   154\t      storyModel: serverEnv.storyModel,\n   155\t      ttsEnabled: serverEnv.ttsEnabled,\n   156\t      ttsProvider: serverEnv.ttsProvider,\n   157\t    }),\n   158\t  });\n   159\t}\n   160\t\n   161\t// ── Lecture pure lignes → config (golden-testée sans DB) ─────────────────────\n   162\t\n   163\ttype Rows = ReadonlyMap<string, string>;\n   164\t\n   165\t/** Booléen DB : \"true\"/\"false\" seulement ; tout le reste → fallback\n   166\t * (« invalid means fallback » — un rien ne force jamais false). */\n   167\tfunction boolRow(rows: Rows, key: SettingKey, fallback: boolean): boolean {\n   168\t  const raw = rows.get(key);\n   169\t  if (raw === \"true\") {\n   170\t    return true;\n   171\t  }\n   172\t  if (raw === \"false\") {\n   173\t    return false;\n   174\t  }\n   175\t  return fallback;\n   176\t}\n   177\t\n   178\tfunction enumRow<T extends string>(\n   179\t  rows: Rows,\n   180\t  key: SettingKey,\n   181\t  allowed: readonly T[],\n   182\t  fallback: T\n   183\t): T {\n   184\t  const raw = rows.get(key);\n   185\t  return allowed.includes(raw as T) ? (raw as T) : fallback;\n   186\t}\n   187\t\n   188\t/** Chaîne non-secrète : une ligne vide ou absente → fallback. */\n   189\tfunction textRow(rows: Rows, key: SettingKey, fallback: string): string {\n   190\t  const raw = rows.get(key);\n   191\t  return raw ? raw : fallback;\n   192\t}\n   193\t\n   194\t/** Secret : la présence de la ligne gagne, MÊME vide (masque explicite). */\n   195\tfunction secretRow(rows: Rows, key: SettingKey, fallback: string): string {\n   196\t  const raw = rows.get(key);\n   197\t  return raw === undefined ? fallback : raw;\n   198\t}\n   199\t\n   200\t/** Fusion pure lignes DB + fallback — exportée pour les goldens. */\n   201\texport function configFromRows(rows: Rows, fallback: AppConfig): AppConfig {\n   202\t  return Object.freeze({\n   203\t    branding: Object.freeze({\n   204\t      appDescription: textRow(\n   205\t        rows,\n   206\t        \"branding:app-description\",\n   207\t        fallback.branding.appDescription\n   208\t      ),\n   209\t      appName: textRow(rows, \"branding:app-name\", fallback.branding.appName),\n   210\t      childName: textRow(\n   211\t        rows,\n   212\t        \"branding:child-name\",\n   213\t        fallback.branding.childName\n   214\t      ),\n   215\t      storyLabel: textRow(\n   216\t        rows,\n   217\t        \"branding:story-label\",\n   218\t        fallback.branding.storyLabel\n   219\t      ),\n   220\t    }),\n   221\t    provider: Object.freeze({\n   222\t      anthropicApiKey: secretRow(\n   223\t        rows,\n   224\t        \"text:anthropic-api-key\",\n   225\t        fallback.provider.anthropicApiKey\n   226\t      ),\n   227\t      defaultLang: enumRow(\n   228\t        rows,\n   229\t        \"story:default-lang\",\n   230\t        STORY_LANGS,\n   231\t        fallback.provider.defaultLang\n   232\t      ),\n   233\t      elevenLabsApiKey: secretRow(\n   234\t        rows,\n   235\t        \"tts:elevenlabs-api-key\",\n   236\t        fallback.provider.elevenLabsApiKey\n   237\t      ),\n   238\t      geminiApiKey: secretRow(\n   239\t        rows,\n   240\t        \"image:gemini-api-key\",\n   241\t        fallback.provider.geminiApiKey\n   242\t      ),\n   243\t      imageEnabled: boolRow(\n   244\t        rows,\n   245\t        \"image:enabled\",\n   246\t        fallback.provider.imageEnabled\n   247\t      ),\n   248\t      imageModel: textRow(rows, \"image:model\", fallback.provider.imageModel),\n   249\t      imageResolution: enumRow(\n   250\t        rows,\n   251\t        \"image:resolution\",\n   252\t        IMAGE_RESOLUTIONS,\n   253\t        fallback.provider.imageResolution\n   254\t      ),\n   255\t      storyModel: textRow(\n   256\t        rows,\n   257\t        \"text:story-model\",\n   258\t        fallback.provider.storyModel\n   259\t      ),\n   260\t      ttsEnabled: boolRow(rows, \"tts:enabled\", fallback.provider.ttsEnabled),\n   261\t      ttsProvider: enumRow(\n   262\t        rows,\n   263\t        \"tts:provider\",\n   264\t        TTS_PROVIDERS,\n   265\t        fallback.provider.ttsProvider\n   266\t      ),\n   267\t    }),\n   268\t  });\n   269\t}\n   270\t\n   271\t// ── L'instantané par opération logique ───────────────────────────────────────\n   272\t\n   273\t/**\n   274\t * UN instantané immuable de la configuration effective. À prendre à la\n   275\t * FRONTIÈRE de chaque server function et à faire descendre — jamais rappelé\n   276\t * au milieu d'une opération. Ne jette JAMAIS (précédent getUiLocaleFn) : DB\n   277\t * injoignable → config env seulement + log serveur ; l'enfant ne voit jamais\n   278\t * une erreur de configuration.\n   279\t */\n   280\texport async function getAppConfig(): Promise<AppConfig> {\n   281\t  const fallback = envFallbackConfig();\n   282\t  try {\n   283\t    const { db } = await import(\"~/server/db\");\n   284\t    const all = await db.select().from(appSettings);\n   285\t    const rows = new Map(all.map((row) => [row.key, row.value]));\n   286\t    return configFromRows(rows, fallback);\n   287\t  } catch (error) {\n   288\t    console.error(\"getAppConfig (fallback env seul):\", error);\n   289\t    return fallback;\n   290\t  }\n   291\t}\n   292\t\n   293\t/** Les lignes brutes posées par le parent — pour l'écran de réglages (badge\n   294\t * « par défaut ») ; mêmes garanties never-throw que getAppConfig. */\n   295\texport async function getSettingRows(): Promise<ReadonlyMap<string, string>> {\n   296\t  try {\n   297\t    const { db } = await import(\"~/server/db\");\n   298\t    const all = await db.select().from(appSettings);\n   299\t    return new Map(all.map((row) => [row.key, row.value]));\n   300\t  } catch (error) {\n   301\t    console.error(\"getSettingRows (aucune ligne):\", error);\n   302\t    return new Map();\n   303\t  }\n   304\t}\n   305\t\n   306\t// ── Masquage des secrets ─────────────────────────────────────────────────────\n   307\t\n   308\t/**\n   309\t * Indice non-réversible d'un secret pour l'UI parent : jamais plus que les\n   310\t * 3 derniers caractères (\"…7Yq\"). Un secret vide ou trop court → \"\".\n   311\t */\n   312\texport function hintFor(secret: string): string {\n   313\t  if (secret.length < 8) {\n   314\t    return \"\";\n   315\t  }\n   316\t  return `…${secret.slice(-3)}`;\n   317\t}\n   318\t\n   319\t// ── Flags publics (client) ───────────────────────────────────────────────────\n   320\t\n   321\t/**\n   322\t * Flags that are safe to send to the client so the UI can hide/show the\n   323\t * \"Écouter\" button and the illustration slot. No secrets here. Dérivés de\n   324\t * l'INSTANTANÉ de config (jamais de l'env seul) : un toggle posé en base\n   325\t * s'applique à la prochaine requête, sans rebuild.\n   326\t */\n   327\texport interface PublicFlags {\n   328\t  defaultLang: StoryLang;\n   329\t  imageEnabled: boolean;\n   330\t  // The default image model, mirrored so the /parents picker's \"par défaut\"\n   331\t  // badge + the localStorage hook's default track the deployed value (not a\n   332\t  // hard-coded mirror). The id itself is not a secret.\n   333\t  imageModel: string;\n   334\t  ttsEnabled: boolean;\n   335\t}\n   336\t\n   337\texport function publicFlagsFromConfig(provider: ProviderConfig): PublicFlags {\n   338\t  return {\n   339\t    defaultLang: provider.defaultLang,\n   340\t    imageEnabled: provider.imageEnabled,\n   341\t    imageModel: provider.imageModel,\n   342\t    ttsEnabled: provider.ttsEnabled,\n   343\t  };\n   344\t}\n   345\t\n   346\t// ── Statut pour l'écran parent (formes SANS secret) ──────────────────────────\n   347\t\n   348\t/** D'où vient la valeur effective : une ligne posée par le parent (\"db\") ou\n   349\t * le déploiement (\"default\" = env ou défaut du code). Une ligne invalide\n   350\t * retombe côté \"default\" — le badge dit la vérité effective. */\n   351\texport type SettingSource = \"db\" | \"default\";\n   352\t\n   353\texport interface SecretStatus {\n   354\t  configured: boolean;\n   355\t  hint: string;\n   356\t  source: SettingSource;\n   357\t}\n   358\t\n   359\texport interface ValueStatus<T> {\n   360\t  source: SettingSource;\n   361\t  value: T;\n   362\t}\n   363\t\n   364\t/**\n   365\t * Code de statut de CONFIGURATION par fonctionnalité — délibérément distinct\n   366\t * des codes d'échec provider (\"save-failed\", soft-failures) : « pas de clé »\n   367\t * n'est pas « le provider a échoué ». Libellés côté client (catalogue i18n).\n   368\t */\n   369\texport type FeatureConfigStatus = \"ready\" | \"off\" | \"missing-key\";\n   370\t\n   371\texport interface AppSettingsStatus {\n   372\t  branding: {\n   373\t    appDescription: ValueStatus<string>;\n   374\t    appName: ValueStatus<string>;\n   375\t    childName: ValueStatus<string>;\n   376\t    storyLabel: ValueStatus<string>;\n   377\t  };\n   378\t  features: {\n   379\t    image: FeatureConfigStatus;\n   380\t    text: FeatureConfigStatus;\n   381\t    tts: FeatureConfigStatus;\n   382\t  };\n   383\t  provider: {\n   384\t    anthropicApiKey: SecretStatus;\n   385\t    defaultLang: ValueStatus<StoryLang>;\n   386\t    elevenLabsApiKey: SecretStatus;\n   387\t    geminiApiKey: SecretStatus;\n   388\t    imageEnabled: ValueStatus<boolean>;\n   389\t    imageModel: ValueStatus<string>;\n   390\t    imageResolution: ValueStatus<ImageResolution>;\n   391\t    storyModel: ValueStatus<string>;\n   392\t    ttsEnabled: ValueStatus<boolean>;\n   393\t    ttsProvider: ValueStatus<TtsProviderName>;\n   394\t  };\n   395\t}\n   396\t\n   397\tfunction secretStatus(rows: Rows, key: SettingKey, effective: string) {\n   398\t  return {\n   399\t    configured: effective.length > 0,\n   400\t    hint: hintFor(effective),\n   401\t    source: (rows.has(key) ? \"db\" : \"default\") as SettingSource,\n   402\t  };\n   403\t}\n   404\t\n   405\tfunction valueStatus<T>(rows: Rows, key: SettingKey, effective: T) {\n   406\t  // Source EFFECTIVE : une ligne invalide (retombée fallback) est déclarée\n   407\t  // \"default\" — le badge ne prétend jamais qu'une valeur bricolée s'applique.\n   408\t  const raw = rows.get(key);\n   409\t  const applied =\n   410\t    raw !== undefined && String(effective) === raw ? \"db\" : \"default\";\n   411\t  return { source: applied as SettingSource, value: effective };\n   412\t}\n   413\t\n   414\tfunction imageStatus(provider: ProviderConfig): FeatureConfigStatus {\n   415\t  if (!provider.imageEnabled) {\n   416\t    return \"off\";\n   417\t  }\n   418\t  return provider.geminiApiKey ? \"ready\" : \"missing-key\";\n   419\t}\n   420\t\n   421\tfunction ttsStatus(provider: ProviderConfig): FeatureConfigStatus {\n   422\t  if (!provider.ttsEnabled) {\n   423\t    return \"off\";\n   424\t  }\n   425\t  if (provider.ttsProvider === \"elevenlabs\" && !provider.elevenLabsApiKey) {\n   426\t    return \"missing-key\";\n   427\t  }\n   428\t  return \"ready\";\n   429\t}\n   430\t\n   431\texport function featureStatuses(\n   432\t  provider: ProviderConfig\n   433\t): AppSettingsStatus[\"features\"] {\n   434\t  return {\n   435\t    image: imageStatus(provider),\n   436\t    text: provider.anthropicApiKey ? \"ready\" : \"missing-key\",\n   437\t    tts: ttsStatus(provider),\n   438\t  };\n   439\t}\n   440\t\n   441\t/**\n   442\t * Forme envoyée au parent — construite PURE depuis (lignes, fallback) pour le\n   443\t * golden « boundary secret-scan » : aucun champ ne porte jamais un secret,\n   444\t * seulement {configured, hint}.\n   445\t */\n   446\texport function settingsStatusFromRows(\n   447\t  rows: Rows,\n   448\t  fallback: AppConfig\n   449\t): AppSettingsStatus {\n   450\t  const config = configFromRows(rows, fallback);\n   451\t  return {\n   452\t    branding: {\n   453\t      appDescription: valueStatus(\n   454\t        rows,\n   455\t        \"branding:app-description\",\n   456\t        config.branding.appDescription\n   457\t      ),\n   458\t      appName: valueStatus(rows, \"branding:app-name\", config.branding.appName),\n   459\t      childName: valueStatus(\n   460\t        rows,\n   461\t        \"branding:child-name\",\n   462\t        config.branding.childName\n   463\t      ),\n   464\t      storyLabel: valueStatus(\n   465\t        rows,\n   466\t        \"branding:story-label\",\n   467\t        config.branding.storyLabel\n   468\t      ),\n   469\t    },\n   470\t    features: featureStatuses(config.provider),\n   471\t    provider: {\n   472\t      anthropicApiKey: secretStatus(\n   473\t        rows,\n   474\t        \"text:anthropic-api-key\",\n   475\t        config.provider.anthropicApiKey\n   476\t      ),\n   477\t      defaultLang: valueStatus(\n   478\t        rows,\n   479\t        \"story:default-lang\",\n   480\t        config.provider.defaultLang\n   481\t      ),\n   482\t      elevenLabsApiKey: secretStatus(\n   483\t        rows,\n   484\t        \"tts:elevenlabs-api-key\",\n   485\t        config.provider.elevenLabsApiKey\n   486\t      ),\n   487\t      geminiApiKey: secretStatus(\n   488\t        rows,\n   489\t        \"image:gemini-api-key\",\n   490\t        config.provider.geminiApiKey\n   491\t      ),\n   492\t      imageEnabled: valueStatus(\n   493\t        rows,\n   494\t        \"image:enabled\",\n   495\t        config.provider.imageEnabled\n   496\t      ),\n   497\t      imageModel: valueStatus(rows, \"image:model\", config.provider.imageModel),\n   498\t      imageResolution: valueStatus(\n   499\t        rows,\n   500\t        \"image:resolution\",\n   501\t        config.provider.imageResolution\n   502\t      ),\n   503\t      storyModel: valueStatus(\n   504\t        rows,\n   505\t        \"text:story-model\",\n   506\t        config.provider.storyModel\n   507\t      ),\n   508\t      ttsEnabled: valueStatus(rows, \"tts:enabled\", config.provider.ttsEnabled),\n   509\t      ttsProvider: valueStatus(\n   510\t        rows,\n   511\t        \"tts:provider\",\n   512\t        config.provider.ttsProvider\n   513\t      ),\n   514\t    },\n   515\t  };\n   516\t}\n   517\t\n   518\t// ── Écritures centrales (validation + normalisation UNIQUEMENT ici) ─────────\n   519\t\n   520\texport type SettingPatchOp =\n   521\t  | { key: string; op: \"set\"; value: string }\n   522\t  | { key: string; op: \"delete\" };\n   523\t\n   524\t/** Même idiome maison que les *-functions.ts (espace, 23 caractères). */\n   525\tfunction nowSqlTimestamp(): string {\n   526\t  return new Date().toISOString().replace(\"T\", \" \").slice(0, 23);\n   527\t}\n   528\t\n   529\tfunction assertWritableKey(key: string): void {\n   530\t  if (!WRITABLE_KEYS.includes(key)) {\n   531\t    throw new Error(`Clé de réglage inconnue: ${key}`);\n   532\t  }\n   533\t}\n   534\t\n   535\t/**\n   536\t * Applique un PATCH au niveau champ dans UNE transaction (db.batch libSQL,\n   537\t * atomique) : deux onglets qui sauvent des sections disjointes ne s'écrasent\n   538\t * jamais ; un batch qui échoue ne change rien. TOUT écrivain passe ici (y\n   539\t * compris saveUiLocaleFn) — la validation de clé ne peut pas être contournée.\n   540\t */\n   541\texport async function applySettingsPatch(\n   542\t  operations: readonly SettingPatchOp[]\n   543\t): Promise<void> {\n   544\t  for (const operation of operations) {\n   545\t    assertWritableKey(operation.key);\n   546\t  }\n   547\t  if (operations.length === 0) {\n   548\t    return;\n   549\t  }\n   550\t  const { db } = await import(\"~/server/db\");\n   551\t  const statements = operations.map((operation) =>\n   552\t    operation.op === \"set\"\n   553\t      ? db\n   554\t          .insert(appSettings)\n   555\t          .values({ key: operation.key, value: operation.value })\n   556\t          .onConflictDoUpdate({\n   557\t            set: { updatedAt: nowSqlTimestamp(), value: operation.value },\n   558\t            target: appSettings.key,\n   559\t          })\n   560\t      : db.delete(appSettings).where(eq(appSettings.key, operation.key))\n   561\t  );\n   562\t  const [first, ...rest] = statements;\n   563\t  if (!first) {\n   564\t    return;\n   565\t  }\n   566\t  await db.batch([first, ...rest]);\n   567\t}\n   568\t\n   569\t/** Pose une valeur (upsert). Passe par applySettingsPatch — une transaction. */\n   570\texport function setSetting(key: string, value: string): Promise<void> {\n   571\t  return applySettingsPatch([{ key, op: \"set\", value }]);\n   572\t}\n   573\t\n   574\t/** Supprime la ligne — « revenir au réglage du déploiement » (l'env reprend). */\n   575\texport function deleteSetting(key: string): Promise<void> {\n   576\t  return applySettingsPatch([{ key, op: \"delete\" }]);\n   577\t}\n     1\timport { createServerFn } from \"@tanstack/react-start\";\n     2\timport { z } from \"zod\";\n     3\timport type { BrandingSource } from \"~/config/app\";\n     4\timport { composeBranding } from \"~/config/app\";\n     5\timport type { Branding } from \"~/lib/i18n\";\n     6\timport {\n     7\t  DEFAULT_LOCALE,\n     8\t  type Locale,\n     9\t  normalizeLocale,\n    10\t} from \"~/lib/i18n/locale\";\n    11\timport {\n    12\t  type AppSettingsStatus,\n    13\t  applySettingsPatch,\n    14\t  configFromRows,\n    15\t  envFallbackConfig,\n    16\t  getSettingRows,\n    17\t  isSecretSettingKey,\n    18\t  SETTING_KEYS,\n    19\t  type SettingKey,\n    20\t  type SettingPatchOp,\n    21\t  setSetting,\n    22\t  settingsStatusFromRows,\n    23\t  UI_LANGUAGE_KEY,\n    24\t} from \"~/server/app-config\";\n    25\t\n    26\t/**\n    27\t * Réglages globaux (table `app_settings`) : la locale de l'INTERFACE et la\n    28\t * MARQUE (choisies par le parent), lues par le loader racine à CHAQUE rendu\n    29\t * SSR — la lecture ne jette JAMAIS (DB injoignable → défauts du déploiement,\n    30\t * log serveur) : le shell doit toujours rendre, l'enfant ne voit jamais une\n    31\t * erreur de configuration. Les écritures renvoient un booléen ou un CODE\n    32\t * calme ; le libellé d'échec appartient au CLIENT (catalogue i18n) — le\n    33\t * serveur ne choisit pas la langue d'un message destiné au parent.\n    34\t */\n    35\t\n    36\t/** Ce que le loader RACINE fournit au shell : la locale UI, la marque\n    37\t * composée pour cette locale (titre d'onglet, portrait) et la source de\n    38\t * marque brute — pour que les consommateurs à LANGUE D'HISTOIRE (colophon\n    39\t * imprimé) recomposent via composeBranding(story.lang). Aucun secret. */\n    40\texport interface ShellContext {\n    41\t  branding: Branding;\n    42\t  brandingSource: BrandingSource;\n    43\t  locale: Locale;\n    44\t}\n    45\t\n    46\texport const getShellContextFn = createServerFn({ method: \"GET\" }).handler(\n    47\t  async (): Promise<ShellContext> => {\n    48\t    try {\n    49\t      const rows = await getSettingRows();\n    50\t      const locale = normalizeLocale(rows.get(UI_LANGUAGE_KEY));\n    51\t      const { branding } = configFromRows(rows, envFallbackConfig());\n    52\t      return {\n    53\t        branding: composeBranding(locale, branding),\n    54\t        brandingSource: branding,\n    55\t        locale,\n    56\t      };\n    57\t    } catch (error) {\n    58\t      // Même contrat que l'ancien getUiLocaleFn : ne jette JAMAIS — le shell\n    59\t      // rend toujours, au pire en français avec la marque du déploiement.\n    60\t      console.error(\"getShellContextFn:\", error);\n    61\t      const fallback = envFallbackConfig().branding;\n    62\t      return {\n    63\t        branding: composeBranding(DEFAULT_LOCALE, fallback),\n    64\t        brandingSource: fallback,\n    65\t        locale: DEFAULT_LOCALE,\n    66\t      };\n    67\t    }\n    68\t  }\n    69\t);\n    70\t\n    71\texport const saveUiLocaleFn = createServerFn({ method: \"POST\" })\n    72\t  .validator(z.object({ locale: z.enum([\"fr\", \"en\"]) }))\n    73\t  .handler(async ({ data }): Promise<{ success: boolean }> => {\n    74\t    try {\n    75\t      // Écrivain CENTRAL (app-config.ts) : tout writer de `app_settings`\n    76\t      // passe par setSetting/applySettingsPatch — validation de clé et\n    77\t      // transaction ne peuvent pas être contournées.\n    78\t      await setSetting(UI_LANGUAGE_KEY, data.locale);\n    79\t      return { success: true };\n    80\t    } catch (error) {\n    81\t      // Le détail technique (chemin du fichier SQLite, SQL) reste côté serveur — le\n    82\t      // parent reçoit un état calme, libellé par le catalogue client.\n    83\t      console.error(\"saveUiLocaleFn:\", error);\n    84\t      return { success: false };\n    85\t    }\n    86\t  });\n    87\t\n    88\t/* ── Réglages de l'atelier (/parents/reglages) ─────────────────────────────\n    89\t * Lecture : la forme statut SANS SECRET (valeurs non-secrètes + {configured,\n    90\t * hint} pour les clés — jamais la clé elle-même ; épinglé par le scan de\n    91\t * frontière de test:settings). Écriture : un PATCH au niveau champ, validé\n    92\t * par zod, exécuté en UNE transaction via l'écrivain central — deux onglets\n    93\t * qui sauvent des sections disjointes ne s'écrasent jamais. Les secrets\n    94\t * suivent les QUATRE opérations : conserver (absent du patch) / définir /\n    95\t * masque explicite (set \"\") / revenir au déploiement (delete). */\n    96\t\n    97\texport const getAppSettingsStatusFn = createServerFn({ method: \"GET\" }).handler(\n    98\t  async (): Promise<AppSettingsStatus> =>\n    99\t    // Never-throw des deux côtés (getSettingRows → Map vide sur échec DB) :\n   100\t    // la page parent rend toujours, au pire l'état « déploiement seul ».\n   101\t    settingsStatusFromRows(await getSettingRows(), envFallbackConfig())\n   102\t);\n   103\t\n   104\tconst settingKeyValues = SETTING_KEYS as readonly [SettingKey, ...SettingKey[]];\n   105\t\n   106\t/** Valeurs acceptées à l'ÉCRITURE pour les clés à domaine fermé (la lecture\n   107\t * reste tolérante — invalid means fallback — mais on refuse d'écrire\n   108\t * proprement une valeur qui serait ignorée, précédent saveMathSettingsFn). */\n   109\tfunction valeurEcrivable(key: SettingKey, value: string): boolean {\n   110\t  switch (key) {\n   111\t    case \"image:enabled\":\n   112\t    case \"tts:enabled\":\n   113\t      return value === \"true\" || value === \"false\";\n   114\t    case \"image:resolution\":\n   115\t      return [\"512\", \"1K\", \"2K\", \"4K\"].includes(value);\n   116\t    case \"tts:provider\":\n   117\t      return value === \"edge\" || value === \"elevenlabs\";\n   118\t    case \"story:default-lang\":\n   119\t      return [\"fr\", \"ru\", \"en\"].includes(value);\n   120\t    default:\n   121\t      return true;\n   122\t  }\n   123\t}\n   124\t\n   125\tconst operationSchema = z\n   126\t  .discriminatedUnion(\"op\", [\n   127\t    z.object({\n   128\t      key: z.enum(settingKeyValues),\n   129\t      op: z.literal(\"set\"),\n   130\t      value: z.string().max(500),\n   131\t    }),\n   132\t    z.object({ key: z.enum(settingKeyValues), op: z.literal(\"delete\") }),\n   133\t  ])\n   134\t  .refine(\n   135\t    (operation) =>\n   136\t      operation.op !== \"set\" || valeurEcrivable(operation.key, operation.value),\n   137\t    \"Valeur hors domaine pour cette clé.\"\n   138\t  );\n   139\t\n   140\tconst savePatchSchema = z.object({\n   141\t  operations: z\n   142\t    .array(operationSchema)\n   143\t    .min(1)\n   144\t    .max(SETTING_KEYS.length)\n   145\t    .refine(\n   146\t      (ops) => new Set(ops.map((o) => o.key)).size === ops.length,\n   147\t      \"Clé en double dans le patch.\"\n   148\t    ),\n   149\t});\n   150\t\n   151\texport type AppSettingsMutationResult =\n   152\t  // Code stable, jamais une phrase (précédent saveMathSettingsFn) : le\n   153\t  // libellé appartient au catalogue client. Le statut frais évite un\n   154\t  // aller-retour supplémentaire après enregistrement.\n   155\t  | { success: true; status: AppSettingsStatus }\n   156\t  | { success: false; code: \"save-failed\" };\n   157\t\n   158\texport const saveAppSettingsFn = createServerFn({ method: \"POST\" })\n   159\t  .validator(savePatchSchema)\n   160\t  .handler(async ({ data }): Promise<AppSettingsMutationResult> => {\n   161\t    // Normalisation d'écriture : un champ TEXTE non-secret vidé =