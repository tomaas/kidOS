venlabs-api-key\",\n   228\t      \"story:default-lang\",\n   229\t      \"branding:child-name\",\n   230\t      \"branding:app-name\",\n   231\t      \"branding:app-description\",\n   232\t      \"branding:story-label\",\n   233\t    ]),\n   234\t  JSON.stringify(SETTING_KEYS)\n   235\t);\n   236\t\n   237\t// ── 2. Précédence pure (db > env > défaut) — fallback STUB injecté ───────────\n   238\t\n   239\tconst stubFallback: AppConfigT = Object.freeze({\n   240\t  branding: Object.freeze({\n   241\t    appDescription: \"env-description\",\n   242\t    appName: \"env-name\",\n   243\t    childName: \"env-child\",\n   244\t    storyLabel: \"env-label\",\n   245\t  }),\n   246\t  provider: Object.freeze({\n   247\t    anthropicApiKey: \"env-anthropic-key-123456\",\n   248\t    defaultLang: \"fr\" as const,\n   249\t    elevenLabsApiKey: \"\",\n   250\t    geminiApiKey: \"env-gemini-key-123456\",\n   251\t    imageEnabled: false,\n   252\t    imageModel: \"env-image-model\",\n   253\t    imageResolution: \"1K\" as const,\n   254\t    storyModel: \"env-story-model\",\n   255\t    ttsEnabled: true,\n   256\t    ttsProvider: \"edge\" as const,\n   257\t  }),\n   258\t});\n   259\t\n   260\t{\n   261\t  const merged = configFromRows(new Map(), stubFallback);\n   262\t  check(\n   263\t    \"no rows → env fallback verbatim (all fields)\",\n   264\t    JSON.stringify(merged) === JSON.stringify(stubFallback),\n   265\t    JSON.stringify(merged)\n   266\t  );\n   267\t}\n   268\t{\n   269\t  const merged = configFromRows(\n   270\t    new Map([\n   271\t      [\"text:story-model\", \"db-story-model\"],\n   272\t      [\"branding:child-name\", \"Léa\"],\n   273\t    ]),\n   274\t    stubFallback\n   275\t  );\n   276\t  check(\n   277\t    \"db row wins over env (text + branding)\",\n   278\t    merged.provider.storyModel === \"db-story-model\" &&\n   279\t      merged.branding.childName === \"Léa\" &&\n   280\t      merged.provider.imageModel === \"env-image-model\",\n   281\t    JSON.stringify(merged)\n   282\t  );\n   283\t}\n   284\t\n   285\t// ── 3. Booléens/enums DB : invalid means FALLBACK ────────────────────────────\n   286\t\n   287\tconst boolCase = (raw: string | undefined) => {\n   288\t  const rows = new Map<string, string>();\n   289\t  if (raw !== undefined) {\n   290\t    rows.set(\"image:enabled\", raw);\n   291\t  }\n   292\t  return configFromRows(rows, stubFallback).provider.imageEnabled;\n   293\t};\n   294\tcheck(\"bool: missing row → fallback (false)\", boolCase(undefined) === false);\n   295\tcheck('bool: \"true\" → true', boolCase(\"true\") === true);\n   296\tcheck('bool: \"false\" → false', boolCase(\"false\") === false);\n   297\tcheck('bool: \"\" (vide) → fallback, jamais false forcé', boolCase(\"\") === false);\n   298\t{\n   299\t  const withTrueFallback = configFromRows(\n   300\t    new Map([[\"tts:enabled\", \"banana\"]]),\n   301\t    stubFallback\n   302\t  ).provider.ttsEnabled;\n   303\t  check(\n   304\t    \"bool: garbage row → FALLBACK (true kept), not disabled\",\n   305\t    withTrueFallback === true\n   306\t  );\n   307\t}\n   308\t{\n   309\t  const resolution = (raw?: string) => {\n   310\t    const rows = new Map<string, string>();\n   311\t    if (raw !== undefined) {\n   312\t      rows.set(\"image:resolution\", raw);\n   313\t    }\n   314\t    return configFromRows(rows, stubFallback).provider.imageResolution;\n   315\t  };\n   316\t  check(\"enum: missing → fallback (1K)\", resolution(undefined) === \"1K\");\n   317\t  check('enum: \"2K\" valid → applied', resolution(\"2K\") === \"2K\");\n   318\t  check('enum: garbage (\"8K\") → fallback', resolution(\"8K\") === \"1K\");\n   319\t  const lang = configFromRows(\n   320\t    new Map([[\"story:default-lang\", \"de\"]]),\n   321\t    stubFallback\n   322\t  ).provider.defaultLang;\n   323\t  check(\"enum: invalid lang → fallback fr\", lang === \"fr\");\n   324\t  const provider = configFromRows(\n   325\t    new Map([[\"tts:provider\", \"elevenlabs\"]]),\n   326\t    stubFallback\n   327\t  ).provider.ttsProvider;\n   328\t  check(\"enum: valid tts provider applied\", provider === \"elevenlabs\");\n   329\t}\n   330\t\n   331\t// ── 4. Sémantique SECRET en lecture (les quatre états) ───────────────────────\n   332\t\n   333\t{\n   334\t  const noRow = configFromRows(new Map(), stubFallback);\n   335\t  check(\n   336\t    \"secret: no row → env key (keep/reset state)\",\n   337\t    noRow.provider.anthropicApiKey === \"env-anthropic-key-123456\"\n   338\t  );\n   339\t  const set = configFromRows(\n   340\t    new Map([[\"text:anthropic-api-key\", PLANTED.anthropic]]),\n   341\t    stubFallback\n   342\t  );\n   343\t  check(\n   344\t    \"secret: row set → db value wins\",\n   345\t    set.provider.anthropicApiKey === PLANTED.anthropic\n   346\t  );\n   347\t  const masked = configFromRows(\n   348\t    new Map([[\"text:anthropic-api-key\", \"\"]]),\n   349\t    stubFallback\n   350\t  );\n   351\t  check(\n   352\t    'secret: row \"\" → MASQUE explicite (env neutralisée, feature unconfigured)',\n   353\t    masked.provider.anthropicApiKey === \"\"\n   354\t  );\n   355\t}\n   356\t\n   357\t// ── 5. hintFor ───────────────────────────────────────────────────────────────\n   358\t\n   359\tcheck('hintFor: empty → \"\"', hintFor(\"\") === \"\");\n   360\tcheck(\n   361\t  'hintFor: short (<8) → \"\" (jamais révélateur)',\n   362\t  hintFor(\"abcdefg\") === \"\"\n   363\t);\n   364\tcheck(\n   365\t  \"hintFor: long → …3 derniers caractères\",\n   366\t  hintFor(\"sk-ant-abcdefgh7Yq\") === \"…7Yq\"\n   367\t);\n   368\t\n   369\t// ── 6. Boundary secret-scan sur la forme statut ──────────────────────────────\n   370\t\n   371\t{\n   372\t  const rows = new Map([\n   373\t    [\"text:anthropic-api-key\", PLANTED.anthropic],\n   374\t    [\"image:gemini-api-key\", PLANTED.gemini],\n   375\t    [\"tts:elevenlabs-api-key\", PLANTED.elevenlabs],\n   376\t    [\"image:enabled\", \"true\"],\n   377\t    [\"tts:enabled\", \"true\"],\n   378\t    [\"tts:provider\", \"elevenlabs\"],\n   379\t  ]);\n   380\t  const status = settingsStatusFromRows(rows, stubFallback);\n   381\t  const serialized = JSON.stringify(status);\n   382\t  const leaked = Object.values(PLANTED).filter((secret) =>\n   383\t    serialized.includes(secret)\n   384\t  );\n   385\t  check(\n   386\t    \"status shape never carries a planted secret (recursive serialize scan)\",\n   387\t    leaked.length === 0,\n   388\t    `leaked=${JSON.stringify(leaked)}`\n   389\t  );\n   390\t  // Le fallback env est un secret aussi — il ne doit pas fuiter non plus.\n   391\t  check(\n   392\t    \"status shape never carries the env fallback secret either\",\n   393\t    !(\n   394\t      serialized.includes(\"env-anthropic-key-123456\") ||\n   395\t      serialized.includes(\"env-gemini-key-123456\")\n   396\t    ),\n   397\t    serialized\n   398\t  );\n   399\t  check(\n   400\t    \"status: configured + hint + source db\",\n   401\t    status.provider.anthropicApiKey.configured &&\n   402\t      status.provider.anthropicApiKey.hint === \"…7Yq\" &&\n   403\t      status.provider.anthropicApiKey.source === \"db\"\n   404\t  );\n   405\t  check(\n   406\t    \"status: features all ready when keys present\",\n   407\t    status.features.text === \"ready\" &&\n   408\t      status.features.image === \"ready\" &&\n   409\t      status.features.tts === \"ready\",\n   410\t    JSON.stringify(status.features)\n   411\t  );\n   412\t}\n   413\t{\n   414\t  const masked = settingsStatusFromRows(\n   415\t    new Map([\n   416\t      [\"text:anthropic-api-key\", \"\"],\n   417\t      [\"image:enabled\", \"true\"],\n   418\t    ]),\n   419\t    stubFallback\n   420\t  );\n   421\t  check(\n   422\t    \"status: masque explicite → unconfigured (missing-key), source db\",\n   423\t    masked.features.text === \"missing-key\" &&\n   424\t      masked.provider.anthropicApiKey.configured === false &&\n   425\t      masked.provider.anthropicApiKey.source === \"db\"\n   426\t  );\n   427\t  check(\n   428\t    \"status: image enabled sans clé db → missing-key… sauf clé env\",\n   429\t    masked.features.image === \"ready\",\n   430\t    \"env gemini fallback still configures the feature\"\n   431\t  );\n   432\t  const off = settingsStatusFromRows(new Map(), stubFallback);\n   433\t  check(\n   434\t    \"status: feature désactivée → off (jamais missing-key)\",\n   435\t    off.features.image === \"off\"\n   436\t  );\n   437\t  check(\n   438\t    \"status: source default quand aucune ligne\",\n   439\t    off.provider.storyModel.source === \"default\" &&\n   440\t      off.provider.storyModel.value === \"env-story-model\"\n   441\t  );\n   442\t  const dirty = settingsStatusFromRows(\n   443\t    new Map([[\"image:resolution\", \"8K\"]]),\n   444\t    stubFallback\n   445\t  );\n   446\t  check(\n   447\t    \"status: ligne invalide déclarée source default (le badge dit vrai)\",\n   448\t    dirty.provider.imageResolution.source === \"default\" &&\n   449\t      dirty.provider.imageResolution.value === \"1K\"\n   450\t  );\n   451\t}\n   452\t\n   453\t// ── 7. Graphe d'imports ──────────────────────────────────────────────────────\n   454\t\n   455\t{\n   456\t  const source = readFileSync(\n   457\t    join(repoRoot, \"src\", \"server\", \"app-config.ts\"),\n   458\t    \"utf8\"\n   459\t  );\n   460\t  const topLevelDbImport = /^import[^;]*from\\s+[\"']~\\/server\\/db[\"']/m.test(\n   461\t    source\n   462\t  );\n   463\t  check(\n   464\t    \"static: app-config.ts has no top-level ~/server/db import\",\n   465\t    !topLevelDbImport\n   466\t  );\n   467\t}\n   468\t\n   469\tconst importSandbox = mkdtempSync(join(tmpdir(), \"app-config-golden-import-\"));\n   470\t{\n   471\t  const r = runChild(\"child:import-only\", { DATA_DIR: importSandbox });\n   472\t  check(\n   473\t    \"subprocess: importing app-config.ts creates NO db file\",\n   474\t    r.status === 0 && r.json().dbFile === false,\n   475\t    r.stdout + r.stderr\n   476\t  );\n   477\t}\n   478\t{\n   479\t  const r = runChild(\"child:import-dynamic\", { DATA_DIR: importSandbox });\n   480\t  check(\n   481\t    \"subprocess: importing text/dynamic.ts creates NO db file\",\n   482\t    r.status === 0 && r.json().dbFile === false,\n   483\t    r.stdout + r.stderr\n   484\t  );\n   485\t}\n   486\t\n   487\t// ── 8. Intégration DB réelle (tmp dir) ───────────────────────────────────────\n   488\t\n   489\tconst dbSandbox = mkdtempSync(join(tmpdir(), \"app-config-golden-db-\"));\n   490\t{\n   491\t  const r = runChild(\"child:roundtrip\", {\n   492\t    ANTHROPIC_API_KEY: \"env-anthropic-key-123456\",\n   493\t    DATA_DIR: join(dbSandbox, \"volume\"),\n   494\t  });\n   495\t  const j = r.json();\n   496\t  check(\"roundtrip child exits 0\", r.status === 0, r.stderr);\n   497\t  check(\n   498\t    \"roundtrip: blank db → env key\",\n   499\t    j.blankKey === \"env-anthropic-key-123456\",\n   500\t    JSON.stringify(j)\n   501\t  );\n   502\t  check(\"roundtrip: set → db key wins\", j.afterSetKey === PLANTED.anthropic);\n   503\t  check(\n   504\t    'roundtrip: masque explicite (\"\" row) → clé effective vide',\n   505\t    j.afterEmptyOverrideKey === \"\"\n   506\t  );\n   507\t  check(\n   508\t    \"roundtrip: reset (delete row) → env key resumes\",\n   509\t    j.afterResetKey === \"env-anthropic-key-123456\"\n   510\t  );\n   511\t  check(\n   512\t    \"roundtrip: disjoint field-level patches both survive\",\n   513\t    JSON.stringify(j.afterDisjoint) ===\n   514\t      JSON.stringify({\n   515\t        imageModel: \"gemini-test-model\",\n   516\t        storyModel: \"claude-test-model\",\n   517\t      }),\n   518\t    JSON.stringify(j.afterDisjoint)\n   519\t  );\n   520\t  check(\n   521\t    \"roundtrip: invalid patch throws and writes NOTHING\",\n   522\t    j.invalidPatchThrew === true &&\n   523\t      j.afterInvalidPatchStoryModel === \"claude-test-model\",\n   524\t    JSON.stringify(j)\n   525\t  );\n   526\t  check(\n   527\t    \"roundtrip: ui-language writes through the central writer\",\n   528\t    j.uiLanguageRow === \"en\"\n   529\t  );\n   530\t}\n   531\t{\n   532\t  const r = runChild(\"child:db-fails\", {\n   533\t    ANTHROPIC_API_KEY: \"env-anthropic-key-123456\",\n   534\t    DATABASE_URL: \"file:/dev/null/nope/app.db\",\n   535\t  });\n   536\t  check(\n   537\t    \"db unreachable: getAppConfig never throws → env-only config, exit 0\",\n   538\t    r.status === 0 && r.json().anthropicKey === \"env-anthropic-key-123456\",\n   539\t    r.stdout + r.stderr\n   540\t  );\n   541\t}\n   542\t\n   543\trmSync(importSandbox, { force: true, recursive: true });\n   544\trmSync(dbSandbox, { force: true, recursive: true });\n   545\t\n   546\tif (failures > 0) {\n   547\t  console.error(`\\nAPP-CONFIG FAILED: ${failures} mismatch(es).`);\n   548\t  process.exit(1);\n   549\t}\n   550\tconsole.log(\n   551\t  \"\\nAPP-CONFIG OK: précédence db>env>défaut, quatre opérations secret, parsing invalid-means-fallback, masquage, scan de frontière, graphe d'imports db-free et patch transactionnel épinglés.\"\n   552\t);\ndiff --git a/package.json b/package.json\nindex db97c57..983cdd8 100644\n--- a/package.json\n+++ b/package.json\n@@ -1,6 +1,6 @@\n {\n   \"name\": \"kidos\",\n-  \"version\": \"0.5.2.2\",\n+  \"version\": \"0.6.0.0\",\n   \"private\": true,\n   \"type\": \"module\",\n   \"scripts\": {\n@@ -15,7 +15,7 @@\n     \"db:generate\": \"drizzle-kit generate\",\n     \"db:migrate\": \"drizzle-kit migrate\",\n     \"db:studio\": \"drizzle-kit studio\",\n-    \"test\": \"bun run test:golden && bun run test:coherence && bun run test:media && bun run test:data-route && bun run test:reading-aids && bun run test:operations && bun run test:bureau && bun run test:i18n && bun run test:routes && bun run test:db\",\n+    \"test\": \"bun run test:golden && bun run test:coherence && bun run test:media && bun run test:data-route && bun run test:reading-aids && bun run test:operations && bun run test:bureau && bun run test:i18n && bun run test:routes && bun run test:settings && bun run test:db\",\n     \"test:golden\": \"bun run src/server/providers/text/__tests__/prompt-identity.golden.ts && bun run src/server/providers/image/__tests__/segment-image-prompt.golden.ts\",\n     \"test:reading-aids\": \"bun run src/lib/reading-aids/__tests__/reading-aids.golden.ts\",\n     \"test:coherence\": \"SKIP_ENV_VALIDATION=1 bun run src/server/providers/text/__tests__/story-coherence.golden.ts && SKIP_ENV_VALIDATION=1 bun run src/server/providers/text/__tests__/english-coherence.golden.ts\",\n@@ -25,6 +25,7 @@\n     \"test:bureau\": \"bun run src/lib/bureau/__tests__/bureau.golden.ts\",\n     \"test:i18n\": \"bun run src/lib/i18n/__tests__/i18n.golden.ts\",\n     \"test:routes\": \"bun run src/lib/bureau/__tests__/routes.golden.ts\",\n+    \"test:settings\": \"bun run src/server/__tests__/app-config.golden.ts\",\n     \"test:db\": \"bun run src/server/db/__tests__/local-sqlite.golden.ts\"\n   },\n   \"dependencies\": {\ndiff --git a/src/server/__tests__/app-config.golden.ts b/src/server/__tests__/app-config.golden.ts\nnew file mode 100644\nindex 0000000..2e41684\n--- /dev/null\n+++ b/src/server/__tests__/app-config.golden.ts\n@@ -0,0 +1,552 @@\n+/**\n+ * APP-CONFIG assertion script — le point de passage unique des réglages\n+ * (env → DB), `src/server/app-config.ts`.\n+ *\n+ * Pins :\n+ *  1. matrice de PRÉCÉDENCE (ligne DB > env > défaut du code) sur la\n+ *     fusion pure `configFromRows` ;\n+ *  2. les QUATRE opérations secret : conserver (pas de ligne) / définir /\n+ *     masque explicite (ligne \"\") / réinitialiser (suppression) ;\n+ *  3. parsing « invalid means FALLBACK » des booléens/enums DB (absent,\n+ *     true, false, vide, corrompu — épinglés séparément) ;\n+ *  4. masquage `hintFor` (jamais plus de 3 caractères de fin) ;\n+ *  5. boundary secret-scan : la forme statut sérialisée ne contient JAMAIS\n+ *     un secret planté ;\n+ *  6. liste canonique des clés GELÉE ;\n+ *  7. graphe d'imports : importer app-config.ts (et dynamic.ts) dans un\n+ *     répertoire vierge ne crée AUCUN fichier db (subprocess) + assertion\n+ *     statique « pas d'import top-level de ~/server/db » ;\n+ *  8. intégration DB réelle (subprocess, tmp dir) : round-trip des quatre\n+ *     opérations, patch transactionnel au niveau champ (updates disjoints\n+ *     qui ne s'écrasent pas, patch invalide → rien d'écrit), never-throw\n+ *     quand la base est inouvrable (config env seule, exit 0).\n+ *\n+ * Même patron standalone que local-sqlite.golden.ts (spawn d'enfants bun\n+ * pour tout ce qui touche l'env process ou la vraie base) :\n+ *   bun run src/server/__tests__/app-config.golden.ts\n+ * (câblé en `bun run test:settings`). Sort non-zéro à la moindre déviation.\n+ */\n+\n+import { spawnSync } from \"node:child_process\";\n+import { existsSync, mkdtempSync, readFileSync, rmSync } from \"node:fs\";\n+import { tmpdir } from \"node:os\";\n+import { dirname, join } from \"node:path\";\n+import { fileURLToPath } from \"node:url\";\n+\n+// Secrets PLANTÉS pour le scan de frontière — improbables dans tout autre\n+// contenu sérialisé.\n+const PLANTED = {\n+  anthropic: \"sk-ant-PLANTED-anthropic-secret-00007Yq\",\n+  elevenlabs: \"el-PLANTED-elevenlabs-secret-0000Zt\",\n+  gemini: \"AIza-PLANTED-gemini-secret-0000Xw\",\n+};\n+\n+// ── Child modes ───────────────────────────────────────────────────────────────\n+\n+const [, , mode] = process.argv;\n+\n+if (mode === \"child:import-only\") {\n+  // Importer le module NE DOIT ni ouvrir ni créer la base (import lazy).\n+  await import(\"~/server/app-config\");\n+  const dataDir = process.env.DATA_DIR ?? \"\";\n+  console.log(JSON.stringify({ dbFile: existsSync(join(dataDir, \"app.db\")) }));\n+  process.exit(0);\n+}\n+\n+if (mode === \"child:import-dynamic\") {\n+  // Le provider texte (importé par les goldens de cohérence) doit r