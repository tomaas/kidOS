# ─── Almost everything is set IN THE APP now ──────────────────────
# Keys, models, images, voice and branding live in the database and are
# managed at /parents/reglages (Settings). Values below act as the
# DEPLOYMENT DEFAULTS: they apply only when nothing is set in the UI
# ("réglage du déploiement" badge). A fresh install can leave this file
# empty, boot, and paste the Anthropic key in the UI.

# ─── Infra (env only — cannot live in the database) ───────────────
# Local SQLite file. Defaults to file:<DATA_DIR>/app.db (in Docker: the
# app-data volume). Migrations apply automatically at startup. Only set
# this to move the file; it must stay a file: URL.
# DATABASE_URL=file:./data/app.db
# Disk folder for generated images/audio + the SQLite db (in Docker this is
# the app-data volume). On an ephemeral filesystem (no volume), set
# BLOB_READ_WRITE_TOKEN instead (Vercel Blob) — media only; the db file
# still needs a persistent disk.
DATA_DIR=./data
# Extra hostnames the Vite DEV server accepts (Vite blocks unknown Host
# headers). Only needed when reaching `bun run dev` through a reverse proxy
# or tunnel; comma-separated. Keep real domains in the gitignored .env.
DEV_ALLOWED_HOSTS=

# ─── Deployment defaults (optional — the UI wins) ─────────────────
# Text: the Anthropic key writes the stories; model fine as-is.
ANTHROPIC_API_KEY=
STORY_MODEL=claude-opus-4-8
# Images (off by default): IMAGE_ENABLED=true + GEMINI_API_KEY.
IMAGE_ENABLED=false
GEMINI_API_KEY=
IMAGE_MODEL=gemini-2.5-flash-image
# Voice (off by default): TTS_ENABLED=true shows the "Listen" button.
# TTS_PROVIDER=edge (free) or elevenlabs (premium, needs its key).
TTS_ENABLED=false
TTS_PROVIDER=edge
ELEVENLABS_API_KEY=
DEFAULT_LANG=fr

# ─── Branding (legacy deployment defaults — prefer the UI) ────────
# Set the child's name and workshop texts at /parents/reglages instead.
# These remain honored as fallbacks for existing deployments:
# VITE_CHILD_NAME=Léa derives "L'atelier de Léa" + "Une histoire de Léa"
# ("de" elides to "d'" before a vowel: Arsène → "d'Arsène").
VITE_CHILD_NAME=
VITE_APP_NAME=
VITE_APP_DESCRIPTION=
VITE_STORY_LABEL=
